#!/usr/bin/env bash
# bx — run a named recipe inside a microVM or a container, with host
# directories mounted.
#
# Usage:
#   bx <recipe> [args...]   # run a recipe (e.g. `bx pi`)
#   bx -v <recipe>          # also show the lifecycle commands bx runs
#   bx -q <recipe>          # errors only
#   bx --list               # list available recipes
#   bx --show <recipe>      # print the resolved recipe, with provenance
#   bx --dry-run <recipe>   # print the machine plan and cost model
#   bx --status             # list machines: name, dir, image, running, size
#   bx --gc [--yes]         # reclaim machines whose origin dir is gone (preview first)
#   bx --new <recipe>       # scaffold a recipe in ~/.bx/recipes
#   bx --version            # print the build, so `bx` in a shell can be matched to a checkout
#   bx --machine <name> <recipe>  # run a recipe on the named machine
#   bx --help
#
# Secrets: a `secret_env` entry is `GUEST=HOSTVAR[:LIFETIME]`, where LIFETIME
# is `ephemeral` (default), `session`, or `persisted`. `ephemeral` injects the
# value into the guest process only. `session` also leaves it in the machine's
# own writable layer (wiped when the machine is deleted). `persisted` means the
# value may reach a durable path and is the user's explicit choice. bx keeps
# the value out of argv, its own state files, and --show output, but the
# runtime writes it into the machine's on-disk bundle config; bx cannot see or
# scrub inside the runtime's storage. Declaring a lifetime records it and warns
# when a run would persist a secret.
#
# Recipes are declarative: `[name]` followed by `key = value` lines. The
# recipe book is the product; bx is the interpreter. See recipes/README.md for
# the format. Sources are read in increasing precedence: the shipped machines/
# and recipes/, ~/.bx.conf, ./.bx.conf, then ~/.bx/machines/, ./.bx/machines/,
# ~/.bx/recipes/, and ./.bx/recipes/. Only `command` is required. No recipe is
# compiled into bx.
#
# A section with a `command` is a command recipe; one without is a machine
# recipe. A command recipe may name a machine (`machine = libc-dev`) and
# override any of its shape keys. `--machine` on the command line replaces the
# shape entirely: the named machine is used as-is and the command recipe's
# machine reference and shape keys are ignored, while its command and
# lifecycle flags survive. `--name` overrides a recipe's machine identity.
#
# A recipe may `extends` another (base values are inherited) and may `resolve`
# a resolver: a program referenced by name that emits recipe values. The
# resolver is the only way a recipe runs host code; recipe values are data and
# are never shell-evaluated.
#
# Recipe keys (every bx setting, plus four):
#   command, image, name, cpus, mem, net, runtime_args, mounts, workdir, keep,
#   reset, bootstrap, bootstrap_env, secret_env, pre_command, name, state_dir,
#   backend, backend_prompt, profile, extends, resolve, machine
# `backend` is the runtime that owns the machine: `smolvm` (a microVM) or
# `podman` (a container; use it inside a machine, where a vm cannot boot). It
# is part of the shape, so changing it forces a recreate. When it is not set,
# bx uses the only runtime installed and asks when both are; `backend_prompt = 1`
# forces the question even when only one is available. A run that cannot answer
# the question (no terminal) is an error naming both choices, never a silent
# pick; `--dry-run` reports the choice a run would make.
#
# `net` is the network mode: `none`, `bridge` (the runtime's own NAT, default),
# or `host` (share the runtime's network namespace). It is part of the shape. A
# container on `bridge` cannot reach the network inside a vm with user-mode
# (krun/TSI) networking, so that combination is refused with the fix: set
# `net = host`, which is the explicit approval to share the guest's namespace.
#
# `runtime_args` is a repeatable list of the backend's own create-time flags,
# passed through verbatim (podman takes `--privileged`, smolvm takes its own
# equivalents). bx never infers or defaults them: it is the one key that can
# widen the fence past the mount set, so a recipe must ask for it, it is part of
# the shape, and it is warned about at create time. This is how a capability the
# backend has but bx has no vocabulary for — running a container inside a
# container, say — is declared without inventing a euphemism for `--privileged`.
# It is how nesting is expressed; see `machines/nested_podman.conf`.
# `mounts`, `runtime_args`, `bootstrap_env`, and `secret_env` may repeat; their
# lines are kept in order. `#` starts a comment; values run to end of line after
# trimming. A value continues on following lines if those lines are indented.
#
# The command runs through `bash -lc` (or `-i -t` when attached to a terminal)
# and its exit status becomes this script's exit status. Extra arguments after
# the recipe name are appended to the recipe's command.
#
# Environment overrides remain: any BX_* variable (BX_IMAGE, BX_CPUS, …) beats
# the config file, so an ad-hoc run needs no recipe.
#
# Concurrency: one machine may only be driven by one invocation at a time. A
# lock is taken per machine name; a second invocation fails fast rather than
# sharing a VM and racing its lifecycle.
#
# State: the machine's create-time shape (image, cpus, mem, mounts) is recorded
# beside the lock. A later run whose shape differs refuses and tells you to
# pass --reset, because smolvm binds mounts at create time and silently reusing
# a stale set is how boot panics happen. The origin directory and secret
# lifetimes are recorded too, so `--status` and `--gc` can report and reclaim
# machines, and so a run can warn before it persists a secret.

# shellcheck disable=SC2317  # backend verbs are dispatched indirectly by _bk
set -euo pipefail

_die() { printf 'bx: %s\n' "$*" >&2; exit 1; }

# Three levels of chatter, so a warm run stays quiet and a cold one explains
# itself. `_note` is for things the user asked to happen (a machine was
# created, a bootstrap ran). It goes to stderr so a recipe's own stdout stays
# piped-clean. BX_VERBOSE=0 (or --quiet) silences everything but errors;
# BX_VERBOSE=2 (or -v) also shows the smolvm commands bx runs under the covers.
#
# A `_run_*` message is incidental narration about the machine on the way to
# running the recipe — it is suppressed when stderr is not a terminal, because
# a caller that piped the guest's output asked for the guest's output, not a
# story about the machine. So `bx pi | grep x` and `pi | grep x` agree. An
# explicit subcommand (`--new`, `--status`, `--gc`) always prints: its output
# is the thing the user asked for, not a side effect. Setting BX_VERBOSE (or
# -v) is an explicit request, so it always wins over the tty heuristic.
_verbosity="${BX_VERBOSE:-1}"
case "$_verbosity" in ''|*[!0-9]*) _verbosity=1 ;; esac
_note() { [[ "$_verbosity" -ge 1 ]] && printf 'bx: %s\n' "$*" >&2 || true; }
_trace(){ [[ "$_verbosity" -ge 2 ]] && printf 'bx: run: %s\n' "$*" >&2 || true; }
# Run-path narration: like _note, but the calm one-liner form for a step the
# user watches happen ("creating …"), and silent when stderr is not a tty and
# the user did not explicitly ask for verbosity.
if [[ -n "${BX_VERBOSE:-}" || "$_verbosity" -ge 2 ]]; then
  _run_verbosity="$_verbosity"
else
  _run_verbosity="$_verbosity"; [[ -t 2 ]] || _run_verbosity=0
fi
_run_note() { [[ "$_run_verbosity" -ge 1 ]] && printf 'bx: %s\n' "$*" >&2 || true; }
_run_say()  { [[ "$_run_verbosity" -ge 1 ]] && printf '%s\n'    "$*" >&2 || true; }


# Host environment a program expects to inherit, so a command inside the
# machine behaves as it does on the host for the things a user controls:
# terminal type, locale, and colour. Only these are forwarded. The fence is
# deliberate — a credential or socket variable is never on this list, so
# forwarding the environment for fidelity does not leak the host.
_bx_env_passthrough="TERM COLORTERM LANG LANGUAGE LC_ALL LC_CTYPE LC_MESSAGES LC_COLLATE TZ"

# Run a command quietly unless we are verbose, in which case show it (and its
# output). Used for smolvm subcommands whose banners and progress bars are
# noise on success but exactly what you want when diagnosing a failure.
_quiet() {
  if [[ "$_verbosity" -ge 2 ]]; then _trace "$*"; "$@"; return $?; fi
  "$@" >/dev/null 2>&1
}

# Run a command quietly, but replay its captured output to stderr if it fails
# and keep its exit status. This is what lets a cold `smolvm machine create`
# be silent on success and still show smolvm's error on failure.
_quiet_or_die() {
  local _msg="$1"; shift
  local _out
  if [[ "$_verbosity" -ge 2 ]]; then _trace "$*"; "$@"; return $?; fi
  if ! _out="$("$@" 2>&1)"; then
    [[ -n "$_out" ]] && printf '%s\n' "$_out" >&2
    _die "$_msg"
  fi
}

# ── the backend engine ──────────────────────────────────────────────────────
# A machine is a microVM (smolvm) or a container (podman). bx's lifecycle —
# exists, create, start, stop, delete, exec, size — is identical either way;
# only the program and its argument shape differ. So a backend is *declared*
# once, as a small descriptor, and every call site in bx goes through the
# generic wrappers below. Adding a runtime is adding a descriptor and its
# verb functions; no caller names a runtime.
#
# The descriptor is the contract a backend must satisfy:
#
#   `_BACKEND_PROGRAMS[i]`  the program on PATH, e.g. `smolvm`
#   `_BACKEND_LABELS[i]`    the noun a person reads: `microVM` or `container`
#   `bk_<name>_exists`     is there a machine by this name?
#   `bk_<name>_create_args` build the create argv into `_create_args`
#   `bk_<name>_create`     create it (uses `_create_args`)
#   `bk_<name>_start`      start it
#   `bk_<name>_stop`       stop it
#   `bk_<name>_delete`     delete it, forcibly
#   `bk_<name>_exec`       exec a command, given a tty flag and the command
#   `bk_<name>_exec_bootstrap`  run the bootstrap before the command
#   `bk_<name>_env_arg`    append one bootstrap `--env` pair to `_bootstrap_env_args`
#   `bk_<name>_passthrough_arg`  append one forwarded `--env` pair to `_passthrough_env_args`
#   `bk_<name>_secret_arg` append one secret to `_secret_args` (name, not value)
#   `bk_<name>_secret_export`   print 1 if the value must be exported by bx
#   `bk_<name>_net_is_bridged`  print 0/1: is `bridge` a userspace NAT this
#                               host's guest cannot route through? (the vm has
#                               its own net; a container's bridge is NAT'd)
#   `bk_<name>_size`       a human size for one machine, or `?`
#   `bk_<name>_image_cached`      is the image already in its store?
#   `bk_<name>_toolchain_present` is the baked toolchain in its writable layer?
#
# bash 3.2 has no associative arrays, so parallel arrays keyed by name stand
# in. The table is closed: a name not declared is rejected, because silently
# picking a runtime is precisely the substitution this tool exists to prevent.
_BACKEND_NAMES=()
_BACKEND_PROGRAMS=()
_BACKEND_LABELS=()
_bk_declare() { # name program label
  _BACKEND_NAMES+=("$1"); _BACKEND_PROGRAMS+=("$2"); _BACKEND_LABELS+=("$3")
}
_bk_program() { # name -> program
  local _i
  for _i in "${!_BACKEND_NAMES[@]}"; do
    [[ "${_BACKEND_NAMES[$_i]}" == "$1" ]] && { printf '%s' "${_BACKEND_PROGRAMS[$_i]}"; return 0; }
  done
  return 1
}
_bk_label() { # name -> the noun a person reads
  local _i
  for _i in "${!_BACKEND_NAMES[@]}"; do
    [[ "${_BACKEND_NAMES[$_i]}" == "$1" ]] && { printf '%s' "${_BACKEND_LABELS[$_i]}"; return 0; }
  done
  return 1
}
_bk_known() { _bk_program "$1" >/dev/null 2>&1; }
_bk_available() { _bk_known "$1" && command -v "$(_bk_program "$1")" >/dev/null 2>&1; }

# A machine with no recorded backend predates the `backend` key. smolvm was the
# only runtime bx shipped before it, so that is what such a record means — not a
# preference for the vm today. Kept here, beside the table, so the one place
# that names a backend for a legacy record is inside the engine rather than in
# `--status` and `--gc`, where adding a third backend would have to remember it.
_bk_legacy_backend() { printf '%s' "${_BACKEND_NAMES[0]:-smolvm}"; }

# Dispatch one verb to the chosen backend: every verb is a function named
# `bk_<backend>_<verb>`, so the wrapper is uniform and no call site branches on
# the runtime's name.
_bk() { # verb [args...]
  local _verb="$1"; shift
  "bk_${_backend}_${_verb}" "$@"
}
# The first declared backend is the original one; `_bk_legacy_backend` leans on
# that ordering, so declare smolvm first.
_bk_declare smolvm smolvm "microVM"
_bk_declare podman podman "container"

# ── choosing the backend ────────────────────────────────────────────────────
# The backend is a property of the machine (it is in the shape), so it is
# chosen before anything is created. The rules, in order:
#
#   1. An explicit `backend` / `BX_BACKEND` always wins. No prompt.
#   2. Else if `backend_prompt` / `BX_BACKEND_PROMPT` is set, ask — the
#      "always prompt" switch, for people who never want bx to pick.
#   3. Else if the choice is *ambiguous* (more than one backend installed),
#      ask: two runtimes on the host is a real choice, and guessing one is how
#      a container quietly becomes the machine you meant to be a vm.
#   4. Else auto-choose the only one available.
#
# A prompt that cannot be answered is a hard error naming both choices, never
# a silent fall back: a non-interactive run (a pipe, CI) must not have a
# runtime chosen *for* it. `--dry-run` never prompts — it is inspection, and
# it must stay runnable with no backend installed at all.

_backend_available_list() { # names available on PATH, one per line
  local _n
  for _n in "${_BACKEND_NAMES[@]}"; do
    _bk_available "$_n" && printf '%s\n' "$_n"
  done
}

# Ask a person to choose. Reads from the terminal, not stdin, so a piped
# command's input is untouched. Dies, naming the choices, when there is no
# terminal to ask.
_backend_choose_interactively() { # available names as args
  # A run with no controlling terminal cannot answer, and it must not have a
  # runtime picked for it. Fail with both choices named, so a log or a CI job
  # carries the fix rather than a mystery.
  if ! { exec 3</dev/tty; } 2>/dev/null; then
    _die "no backend chosen and this run is not interactive.
Install a runtime, or set the backend explicitly:
$(for _n in "$@"; do printf '  backend = %s   (%s)\n' "$_n" "$(_bk_label "$_n")"; done)"
  fi
  exec 3<&-
  local _choice _n _i
  while true; do
    printf 'bx: no backend chosen; which should own this machine?\n' >&2
    _i=0
    for _n in "$@"; do
      _i=$((_i + 1))
      printf '  [%s] %s  (%s)\n' "$_i" "$_n" "$(_bk_label "$_n")" >&2
    done
    printf 'Choose one [1-%s] (or Ctrl-C): ' "$_i" >&2
    read -r _choice </dev/tty || _die "no choice made"
    [[ -n "$_choice" ]] || continue
    # Accept a number, or the name (or its first letter, when unambiguous).
    if [[ "$_choice" =~ ^[0-9]+$ ]] && (( _choice >= 1 && _choice <= _i )); then
      _i=0
      for _n in "$@"; do
        _i=$((_i + 1))
        [[ "$_i" == "$_choice" ]] && { printf '%s' "$_n"; return 0; }
      done
    fi
    for _n in "$@"; do
      [[ "$_n" == "$_choice" || "${_n:0:1}" == "$_choice" ]] && { printf '%s' "$_n"; return 0; }
    done
    printf 'bx: %s is not one of the choices\n' "$_choice" >&2
  done
}

# Runs once the inspection subcommands (`--status`, `--gc`, `--show`) have had
# their chance to exit: those read a machine's recorded backend and must not
# trigger the choice. Everything the lifecycle needs is set here.
_choose_backend() {
  # Read the decision inputs here, not at parse time: a recipe's `backend` and
  # `backend_prompt` keys are applied during recipe resolution, which runs
  # before this function is called but after the engine block is read.
  local _backend_explicit="${BX_BACKEND:-}"
  local _backend_ask="${BX_BACKEND_PROMPT:-0}"

  # 1. Explicit choice: use it. This is the only path that never prompts.
  if [[ -n "$_backend_explicit" ]]; then
    _bk_known "$_backend_explicit" || \
      _die "unknown backend '$_backend_explicit' (expected one of: $(printf '%s ' "${_BACKEND_NAMES[@]}"))"
    _backend="$_backend_explicit"
    _backend_present=1
    _bk_available "$_backend" || _backend_present=0
    return 0
  fi

  # No explicit choice. What is actually installed decides what can be asked.
  local _available _n_available
  _n_available=0
  # Count the newline-separated list *before* joining it, or `wc -l` sees a
  # single line and every ambiguity looks like a lone backend. `_read_lines`
  # absorbs a producer that exits non-zero (the list function returns 1 when
  # nothing is available), so `set -o pipefail` cannot turn an empty list into
  # a silent exit before the `no backend installed` message can be printed.
  while IFS= read -r _one; do
    [[ -n "$_one" ]] && _n_available=$((_n_available + 1))
  done < <(_backend_available_list || true)
  _available="$(_backend_available_list | tr '\n' ' ' || true)"
  _available="${_available% }"

  if [[ "$_n_available" == "0" ]]; then
    # `--dry-run` is inspection and its contract is that it needs no runtime:
    # plan with the default backend and let the plan say it is not installed,
    # rather than refusing to describe a machine the user is only inspecting.
    if [[ "$_dry_run" == "1" ]]; then
      _backend="${_BACKEND_NAMES[0]}"
      _backend_present=0
      return 0
    fi
    _die "no backend installed: none of $(printf '%s ' "${_BACKEND_NAMES[@]}")is on PATH.
Install smolvm (a microVM) or podman (a container), then run again."
  fi

  # `--dry-run` is inspection: it must not block on a prompt. Pick the
  # documented preference (smolvm) and let the plan say so.
  if [[ "$_dry_run" == "1" ]]; then
    if _bk_available smolvm; then _backend="smolvm"; else _backend="${_available%% *}"; fi
    _backend_present=1
    return 0
  fi

  # 2. `backend_prompt` set, or the choice is ambiguous (more than one backend
  #    installed): ask, never guess. A non-interactive run is a hard error.
  if [[ "$_backend_ask" == "1" || "$_backend_ask" == "true" || "$_n_available" -gt 1 ]]; then
    # Word-split on purpose: the names are shell identifiers, and the prompt
    # wants each as its own argument so it can number them.
    # shellcheck disable=SC2086
    _backend="$(_backend_choose_interactively $_available)"
    _backend_present=1
    return 0
  fi

  # 3. Exactly one backend available and no request to be asked: use it.
  _backend="$_available"
  _backend_present=1
}

# Does a machine with this name already exist, according to the backend?
_machine_exists() {
  [[ "$_backend_present" == "1" ]] || return 1
  _bk exists
}

# ── backend verbs ───────────────────────────────────────────────────────────
# One function per lifecycle step, dispatching on the backend. The call sites
# below never name a runtime, so a new backend is added here and nowhere else.
# The two backends differ in more than spelling, and the differences are
# deliberate:
#
#   mounts   smolvm binds a host directory into the vm (`--volume H:G`);
#            podman bind-mounts it (`-v H:G`). Same pair grammar.
#   net      smolvm needs `--net` to enable it; a container is on the default
#            bridge unless told `--network=none`. `net` is a mode, not a flag:
#            `none`, `bridge` (the runtime's own NAT), or `host` (share the
#            runtime's network namespace). `host` is what makes a container
#            work inside a bx vm, whose user-mode (TSI) network cannot forward
#            a container bridge's NAT; bx refuses the impossible combination
#            rather than letting DNS fail at run time. See `_net_guard`.
#   secrets  smolvm takes `--secret-env GUEST=HOST`; a container takes
#            `-e GUEST`, inheriting the value from the exec's environment,
#            which bx sets from the host variable by name. Either way the
#            value never lands in argv — only the name does.
#   image    smolvm pulls and unpacks a rootfs; podman pulls an image.
#
# smolvm: one machine, one vm. The program's subcommands are `machine <verb>`.

bk_smolvm_exists() {
  smolvm machine ls -q 2>/dev/null | grep -qx "$_vm_name"
}

bk_smolvm_create() {
  _quiet_or_die "could not create machine $_vm_name" \
    smolvm machine create "${_create_args[@]}"
}

bk_smolvm_start() {
  _quiet_or_die "machine '$_vm_name' failed to start. If its mounts or image changed
since it was created, recreate it: bx --reset" \
    smolvm machine start --name "$_vm_name"
}

bk_smolvm_stop() { _quiet smolvm machine stop --name "$_vm_name" || true; }

bk_smolvm_delete() { _quiet smolvm machine delete --name "$_vm_name" -f || true; }

# The env args are rendered for the backend by the caller, so this only picks
# the program and the exec form. smolvm needs `--` before the command.
# shellcheck disable=SC2086,SC2068  # deliberate word-splitting of the arg arrays
bk_smolvm_exec() { # tty(0|1) command
  local _tty="$1" _cmd="$2"
  if [[ "$_tty" == "1" ]]; then
    smolvm machine exec --name "$_vm_name" -i -t \
      ${_secret_args[@]+"${_secret_args[@]}"} \
      ${_passthrough_env_args[@]+"${_passthrough_env_args[@]}"} \
      -- bash -lc "$_cmd"
  else
    smolvm machine exec --name "$_vm_name" \
      ${_secret_args[@]+"${_secret_args[@]}"} \
      ${_passthrough_env_args[@]+"${_passthrough_env_args[@]}"} \
      -- bash -lc "$_cmd"
  fi
}

bk_smolvm_size() { # machine name -> bytes-ish human string, or ?
  local _dir="${SMOLVM_STORAGE:-/storage}/overlays/persistent-$1"
  if [[ -d "$_dir" ]]; then du -sh "$_dir" 2>/dev/null | cut -f1; else printf '?'; fi
}

# How a secret crosses: smolvm resolves HOST itself, so the value is never in
# bx's environment. Appends to `_secret_args` (the caller's array) and answers
# whether the host variable must be exported.
bk_smolvm_secret_arg() { _secret_args+=(--secret-env "${_secret_guest}=${_secret_host}"); }
bk_smolvm_secret_export() { printf '0'; }
# A vm has its own network stack; `bridge` is not a userspace NAT a guest has
# to route through, so nothing here is affected by TSI.
bk_smolvm_net_is_bridged() { printf '0'; }

# Build the create argv for a machine. Reads `_vm_name`, `_image`, `_vm_cpus`,
# `_vm_mem`, `_net`, `_want_mounts`, `_want_runtime_args`; writes `_create_args`.
#
# `_want_runtime_args` is passed through verbatim: these are the runtime's own
# flags, and bx does not know or judge them. This is how a capability the
# backend has but bx has no vocabulary for (running a container inside a
# container) is declared from a recipe without inventing a euphemism for it.
# The recipe approves it; bx records and warns about it. See the `runtime_args`
# note above the `_runtime_args_set` check.
bk_smolvm_create_args() {
  _create_args=(--name "$_vm_name" --image "$_image" --cpus "$_vm_cpus" --mem "$_vm_mem")
  [[ "$_net" == "none" ]] || _create_args+=(--net)
  local _mount
  while IFS= read -r _mount; do
    [[ -n "$_mount" ]] || continue
    _create_args+=(--volume "$_mount")
  done < <(printf '%s\n' "$_want_mounts")
  while IFS= read -r _arg; do
    [[ -n "$_arg" ]] || continue
    _create_args+=("$_arg")
  done < <(printf '%s\n' "$_want_runtime_args")
}

# smolvm spells both bootstrap env and host passthrough `--env NAME=VALUE`.
bk_smolvm_env_arg() { _bootstrap_env_args+=(--env "$1"); }
bk_smolvm_passthrough_arg() { _passthrough_env_args+=(--env "$1"); }

# The bootstrap is a non-login exec; smolvm takes `--` before the command.
# shellcheck disable=SC2086,SC2068
bk_smolvm_exec_bootstrap() {
  smolvm machine exec --name "$_vm_name" \
    ${_secret_args[@]+"${_secret_args[@]}"} \
    ${_bootstrap_env_args[@]+"${_bootstrap_env_args[@]}"} \
    -- bash -c "$BX_BOOTSTRAP"
}

bk_smolvm_image_cached() { # image -> cached|not cached|unknown
  local _root="${SMOLVM_STORAGE:-/storage}"
  local _safe; _safe="$(printf '%s' "$1" | sed 's#[/:]#_#g')"
  if [[ -d "$_root/manifests" ]]; then
    [[ -f "$_root/manifests/${_safe}.json" ]] && { printf 'cached'; return 0; }
    printf 'not cached'; return 0
  fi
  printf 'unknown'
}

bk_smolvm_toolchain_present() {
  local _upper="${SMOLVM_STORAGE:-/storage}/overlays/persistent-${_vm_name}/upper"
  if [[ -d "$_upper" ]]; then
    if [[ -e "$_upper/root/.bun" || -e "$_upper/usr/local/bin/pi" ]]; then
      printf 'present'; return 0
    fi
    printf 'absent'; return 0
  fi
  printf 'unknown'
}

# podman: one container per name. `ps -a` includes stopped ones, because a
# stopped machine is still the directory's machine (bx starts it again).

bk_podman_exists() {
  podman ps -a --format '{{.Names}}' 2>/dev/null | grep -qx "$_vm_name"
}

bk_podman_create() {
  _quiet_or_die "could not create container $_vm_name" \
    podman create "${_create_args[@]}"
}

bk_podman_start() {
  _quiet_or_die "container '$_vm_name' failed to start. If its mounts or image changed
since it was created, recreate it: bx --reset" \
    podman start "$_vm_name"
}

bk_podman_stop() { _quiet podman stop "$_vm_name" || true; }

bk_podman_delete() { _quiet podman rm -f "$_vm_name" || true; }

# shellcheck disable=SC2086,SC2068  # deliberate word-splitting of the arg arrays
bk_podman_exec() { # tty(0|1) command
  local _tty="$1" _cmd="$2"
  if [[ "$_tty" == "1" ]]; then
    podman exec -i -t \
      ${_secret_args[@]+"${_secret_args[@]}"} \
      ${_passthrough_env_args[@]+"${_passthrough_env_args[@]}"} \
      "$_vm_name" bash -lc "$_cmd"
  else
    podman exec -i \
      ${_secret_args[@]+"${_secret_args[@]}"} \
      ${_passthrough_env_args[@]+"${_passthrough_env_args[@]}"} \
      "$_vm_name" bash -lc "$_cmd"
  fi
}

bk_podman_size() { # container name -> writable size, or ?
  local _s
  _s="$(podman ps -a --size --filter "name=^$1$" --format '{{.Size}}' 2>/dev/null | head -1)"
  _s="${_s%% *}"
  printf '%s' "${_s:-?}"
}

# podman has no --secret-env; bx exports the host variable and asks for `-e`
# on the guest name, so only the name reaches argv.
bk_podman_secret_arg() { _secret_args+=(-e "${_secret_guest}"); }
bk_podman_secret_export() { printf '1'; }
# A container on podman's default `bridge` sits behind a userspace NAT. Inside a
# TSI guest that NAT cannot route, so `bridge` is the mode this capability is
# about.
bk_podman_net_is_bridged() { printf '1'; }

# Build the create argv. A container runs until its command exits; bx execs
# into it repeatedly, so it is created with a long-lived command and stopped by
# `podman stop`. `--entrypoint ''` plus `sleep infinity` gives exactly that.
bk_podman_create_args() {
  _create_args=(--name "$_vm_name" --cpus "$_vm_cpus" --memory "${_vm_mem}m")
  case "$_net" in
    none)   _create_args+=(--network=none) ;;
    host)   _create_args+=(--network=host) ;;
    bridge) ;;  # the runtime default; no flag needed
  esac
  local _mount
  while IFS= read -r _mount; do
    [[ -n "$_mount" ]] || continue
    _create_args+=(-v "$_mount")
  done < <(printf '%s\n' "$_want_mounts")
  # Backend-native flags, passed through unread (see bk_smolvm_create_args).
  local _arg
  while IFS= read -r _arg; do
    [[ -n "$_arg" ]] || continue
    _create_args+=("$_arg")
  done < <(printf '%s\n' "$_want_runtime_args")
  _create_args+=(--entrypoint '' "$_image" sleep infinity)
}

# A container spells env as `-e`.
bk_podman_env_arg() { _bootstrap_env_args+=(-e "$1"); }
bk_podman_passthrough_arg() { _passthrough_env_args+=(-e "$1"); }

# shellcheck disable=SC2086,SC2068
bk_podman_exec_bootstrap() {
  podman exec -i \
    ${_secret_args[@]+"${_secret_args[@]}"} \
    ${_bootstrap_env_args[@]+"${_bootstrap_env_args[@]}"} \
    "$_vm_name" bash -c "$BX_BOOTSTRAP"
}

bk_podman_image_cached() { # image -> cached|not cached|unknown
  if podman image exists "$1" 2>/dev/null; then printf 'cached'; else printf 'not cached'; fi
}

bk_podman_toolchain_present() {
  # A container's writable layer is podman's, and bx does not read inside it.
  printf 'unknown'
}

# ── generic verb wrappers ───────────────────────────────────────────────────
# Every call site below uses these; none names a runtime. `_bk <verb>` dispatches
# by the chosen backend's name to the `bk_<backend>_<verb>` function above.
_backend_create() { _bk create; }
_backend_start()  { _bk start; }
_backend_stop()   { _bk stop; }
_backend_delete() { _bk delete; }
_backend_exec()   { _bk exec "$@"; }
_backend_image_cached()    { _bk image_cached "$1"; }
_backend_toolchain_present() { _bk toolchain_present; }
_backend_create_args() { _bk create_args; }
_backend_env_arg()     { _bk env_arg "$1"; }
_backend_passthrough_arg() { _bk passthrough_arg "$1"; }
_backend_exec_bootstrap() { _bk exec_bootstrap; }
_backend_secret_export() { _bk secret_export; }

_usage() {
  sed -n '2,70p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

# Report the build, so a `bx` on PATH can be matched to a checkout or an install.
# There is no version number to drift: the commit is the identity. Resolved from
# the checkout that holds this script when it is one, else from the installed
# manifest, else `unknown` — never guessed.
_show_version() {
  local _self _dir _commit _describe _installed _recorded
  _self="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd || echo .)"
  _commit=""
  _describe=""
  # A checkout: this script sits in <root>/bin.
  if git -C "${_self}/.." rev-parse --short HEAD >/dev/null 2>&1; then
    _commit="$(git -C "${_self}/.." rev-parse --short HEAD 2>/dev/null)"
    _describe="$(git -C "${_self}/.." describe --tags --always --dirty 2>/dev/null)"
  fi
  # An install: the commit recorded by install.sh, beside the recipe book.
  _recorded=""
  for _installed in "${_self}/../share/bx/build" "$_self/../build"; do
    [[ -f "$_installed" ]] && { _recorded="$(head -1 "$_installed")"; break; }
  done
  [[ -n "$_describe" ]] || _describe="$_recorded"
  printf 'bx %s\n' "${_describe:-${_commit:-unknown}}"
  printf 'script: %s\n' "$_self/$(basename "${BASH_SOURCE[0]}")"
  [[ -n "$_commit" ]] && printf 'commit: %s\n' "$_commit"
  # An installed script carries no git metadata of its own, so a `build` file
  # that disagrees with the script is only visible if both are reported. This
  # is how a stale `~/.local/bin/bx` stops being invisible.
  [[ -n "$_recorded" ]] && printf 'recorded: %s\n' "$_recorded"
  printf 'recipes: %s\n' "${BX_RECIPES_DIR:-$(_recipes_dir)}"
  printf 'machines: %s\n' "${BX_MACHINES_DIR:-$(_machines_dir)}"
}

# ── recipes ─────────────────────────────────────────────────────────────────
# A recipe is a `[name]` section of `key = value` lines. This is deliberately
# not TOML: the loader must work with nothing but bash, so the grammar is the
# smallest one bash can parse unambiguously. Values are taken verbatim (after
# trimming); repeating a multi-valued key appends rather than replaces.
#
# Bash 3.2 has no associative arrays, so a section's keys are held in variables
# named `_cfg_<recipe>_<key>`. Each `_load_file` overwrites a scalar (so the
# last file read wins) and appends to a multi-valued key (so all sources
# contribute, in the order read: home, project, per-recipe).

_recipe_keys="command image name cpus mem net runtime_args mounts workdir keep reset bootstrap bootstrap_env secret_env pre_command state_dir backend backend_prompt profile extends resolve machine"
_multi_keys="runtime_args mounts bootstrap_env secret_env"

# A recipe key that is not a bx setting but describes the recipe itself.
# `extends` and `resolve` are resolved before the recipe is merged.
_meta_keys="extends resolve machine"

# The keys that define a machine's shape: identity, image, resources, mounts,
# and the one-time setup that must match them. A machine recipe is a section
# with some of these and no `command`. A command recipe may name a machine with
# `machine = ...` and override any of these keys; `--machine` on the command
# line replaces them all. Kept as data so the two rules live in one place.
_shape_keys="image name cpus mem net runtime_args mounts workdir bootstrap bootstrap_env secret_env pre_command state_dir backend"

# ── secret lifetimes ─────────────────────────────────────────────────────────
# A `secret_env` entry is `GUEST=HOSTVAR[:LIFETIME]`. The lifetime is bx's
# declaration of how far the value is allowed to travel:
#   ephemeral (default) — injected into the guest process environment only
#   session             — may live in the machine's writable layer until deletion
#   persisted           — may reach a durable path (the project mount, a file)
# bx does not control the runtime's storage, so it cannot enforce this; it
# records it, refuses to guess, and warns when a run would carry a value
# further than the user asked. A declaration that is always a warning is
# honest; one that silently claims enforcement would not be.
_secret_lifetimes="ephemeral session persisted"

_is_secret_lifetime() {
  local _l
  for _l in $_secret_lifetimes; do [[ "$_l" == "$1" ]] && return 0; done
  return 1
}

# Split `GUEST=HOSTVAR[:LIFETIME]` into three globals. The lifetime defaults to
# ephemeral. A bad lifetime is a hard error, because a typo that silently
# downgrades a secret to `persisted` is exactly the kind of surprise bx exists
# to prevent.
_secret_split() {
  local _spec="$1"
  _secret_guest="${_spec%%=*}"
  _secret_host="${_spec#*=}"
  _secret_life="ephemeral"
  case "$_secret_host" in
    *:*)
      _secret_life="${_secret_host##*:}"
      _secret_host="${_secret_host%:*}"
      _is_secret_lifetime "$_secret_life" || \
        _die "secret_env '$_spec': unknown lifetime '$_secret_life' (use one of: $_secret_lifetimes)"
      ;;
  esac
  [[ -n "$_secret_guest" && -n "$_secret_host" ]] || \
    _die "secret_env '$_spec': expected GUEST=HOSTVAR[:LIFETIME]"
  return 0
}

_is_shape_key() {
  local _k
  for _k in $_shape_keys; do [[ "$_k" == "$1" ]] && return 0; done
  return 1
}

_known_key() {
  local _k
  for _k in $_recipe_keys; do [[ "$_k" == "$1" ]] && return 0; done
  return 1
}

_is_multi_key() {
  local _k
  for _k in $_multi_keys; do [[ "$_k" == "$1" ]] && return 0; done
  return 1
}

# Trim leading and trailing whitespace without external tools.
_trim() {
  local _s="$1"
  _s="${_s#"${_s%%[![:space:]]*}"}"
  _s="${_s%"${_s##*[![:space:]]}"}"
  printf '%s' "$_s"
}

# Newline-separated lists (mounts, bootstrap_env, secret_env) come in as one
# string. Empty entries are ignored. Always returns 0: under `set -e` a
# function whose loop body never runs would otherwise abort the caller.
_read_lines() {
  local _line
  while IFS= read -r _line; do
    [[ -n "$_line" ]] && printf '%s\n' "$_line"
  done <<<"${1:-}"
  return 0
}

# Set `_cfg_<name>_<key>` to `value` without interpreting `value` as shell.
# `printf -v` assigns through a variable name, so a value containing `$`,
# backticks, or quotes is stored literally. This is what makes the "values are
# data, not shell" guarantee real rather than aspirational.
_store_scalar() { # name key value
  printf -v "_cfg_$1_$2" '%s' "$3"
}

_store_append() { # name key value
  local _var="_cfg_$1_$2" _old
  _old="${!_var:-}"
  printf -v "$_var" '%s%s' "${_old:+${_old}
}" "$3"
}

# The description a `--list` shows for a recipe. Held in `_desc_<name>`, set
# from the comment block immediately above the `[section]` line. `just` taught
# the world that the comment above a recipe is its documentation; the shipped
# book already writes one, so this costs recipe authors nothing.
_load_file() {
  local _file="$1" _line _section="" _key _val _continuation=0
  local _pending_desc="" _saw_comment=0
  _file_desc=""
  [[ -f "$_file" ]] || return 0
  while IFS= read -r _line || [[ -n "$_line" ]]; do
    # A value continues onto following lines until a new `key = value`, a new
    # `[section]`, or a blank line. This is how a multi-line `bootstrap` is
    # written. Indented comment lines and blank-within-a-comment lines stay in
    # the value: a bootstrap is shell, and shell has comments. Only a genuinely
    # empty line ends the value, so a recipe author can separate blocks without
    # the loader swallowing what looks like a key.
    if [[ "$_continuation" == 1 ]]; then
      _candidate="$(_trim "${_line%%#*}")"
      if [[ -z "$(_trim "$_line")" ]]; then
        _continuation=0; continue
      elif [[ "$_candidate" == '['*']' ]]; then
        _continuation=0 # a new section ends the value; handled below
      elif [[ "$_candidate" == *=* ]]; then
        _ck="$(_trim "${_candidate%%=*}")"
        _known_key "$_ck" && _continuation=0
      fi
      if [[ "$_continuation" == 1 ]]; then
        _store_append "$_section" "$_key" "$_line"
        continue
      fi
    fi
    _continuation=0
    # Remember the comment block above a `[section]` as its description. A
    # blank line or any key=value between the comment and the section clears
    # it, so only a directly-above comment counts. The whole block is
    # accumulated (lines joined with a space) because these comments are
    # wrapped prose: the first *sentence* is the description, and it may span
    # two physical lines. A leading file-level comment is captured too, so a
    # one-recipe file that opens with `# name — what it does` still works.
    case "$_line" in
      '#'*)
        _comment="$(_trim "${_line#\#}")"
        if [[ "$_section" == "" ]]; then
          _file_desc="${_file_desc:+${_file_desc} }${_comment}"
        else
          _pending_desc="${_pending_desc:+${_pending_desc} }${_comment}"
        fi
        continue ;;
    esac
    _line="$(_trim "${_line%%#*}")"
    if [[ -z "$_line" ]]; then _pending_desc=""; continue; fi
    if [[ "$_line" == '['*']' ]]; then
      _section="$(_trim "${_line#[}")"
      _section="$(_trim "${_section%]}")"
      [[ -n "$_section" ]] || _die "$_file: empty recipe name"
      # The loader stores keys in variables named _cfg_<recipe>_<key>, so a
      # recipe name must be a shell identifier. A hyphen is rejected here
      # rather than failing later with a confusing `printf` error.
      case "$_section" in
        *[!A-Za-z0-9_]*) _die "$_file: recipe name '${_section}' is invalid; use letters, digits, or '_'" ;;
      esac
      case "$_recipe_names" in
        *"
${_section}
"*) ;;
        *) _recipe_names="${_recipe_names}${_section}
" ;;
      esac
      # A description set by an earlier file is not overwritten by a later
      # one that has no comment: the recipe is the name, its doc may live in
      # whichever source first declared it. Held in `_desc_<name>`, not the
      # `_cfg_` namespace, so it can never collide with a user's key.
      if [[ -n "$_pending_desc" ]]; then
        printf -v "_desc_${_section}" '%s' "$_pending_desc"
      else
        eval "_have_desc=\${_desc_${_section}:-}"
        if [[ -z "$_have_desc" && -n "$_file_desc" ]]; then
          printf -v "_desc_${_section}" '%s' "$_file_desc"
        fi
      fi
      _pending_desc=""
      continue
    fi
    [[ -n "$_section" ]] || _die "$_file: line outside a [recipe]: $_line"
    [[ "$_line" == *=* ]] || _die "$_file: expected 'key = value': $_line"
    _key="$(_trim "${_line%%=*}")"
    _val="$(_trim "${_line#*=}")"
    _known_key "$_key" || _die "$_file: unknown key '$_key' in [$_section]"

    # Expand the references a recipe author actually reaches for, so a mount
    # can be written `$PWD:/work` or `~/src:/src`. `$NAME` references to
    # resolver params are substituted at resolve time, not here, because the
    # resolver has not run yet. Nothing else is expanded: values are not
    # shell-evaluated, so a recipe cannot run code.
    case "$_val" in
      *'$PWD'*|*'$HOME'*|*'~'*)
        _val="${_val//\$PWD/$PWD}"
        _val="${_val//\$HOME/${HOME:-}}"
        # A leading ~ is the home directory; there is no other tilde form here.
        case "$_val" in
          "~"/*) _val="${HOME:-}${_val:1}" ;;
          "~")   _val="${HOME:-}" ;;
        esac ;;
    esac

    if _is_multi_key "$_key"; then
      _store_append "$_section" "$_key" "$_val"
    else
      _store_scalar "$_section" "$_key" "$_val"
    fi
    _continuation=1
  done <"$_file"
}

# The names a recipe can refer to: every [section] seen, plus the built-in pi.
_recipe_names=""
_has_recipe() {
  local _name="$1"
  case "
${_recipe_names}" in
    *"
${_name}
"*) return 0 ;;
  esac
  return 1
}

# The shipped recipe book, beside the installed bx or in a checkout. Kept out
# of _recipe_names until loaded, but its location is remembered so `resolve`
# can find a resolver that lives in the book rather than on PATH.
_recipes_dir() {
  local _d _self
  _self="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd || echo .)"
  for _d in "${BX_RECIPES_DIR:-}" \
            "${_self}/../share/bx/recipes" \
            "${_self}/../recipes" \
            "$(dirname "$(command -v bx 2>/dev/null || echo .)")/../share/bx/recipes"; do
    [[ -n "$_d" && -d "$_d" ]] && { (cd "$_d" && pwd); return 0; }
  done
  return 0
}

# The book directory holding machine recipes. Machines live beside the command
# recipes in the source tree and install prefix, so discovery mirrors
# _recipes_dir; the set of directories is what differs.
_machines_dir() {
  local _d _self
  _self="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd || echo .)"
  for _d in "${BX_MACHINES_DIR:-}" \
            "${_self}/../share/bx/machines" \
            "${_self}/../machines" \
            "$(dirname "$(command -v bx 2>/dev/null || echo .)")/../share/bx/machines"; do
    [[ -n "$_d" && -d "$_d" ]] && { (cd "$_d" && pwd); return 0; }
  done
  return 0
}

_load_dir() { # directory
  local _d="$1" _f
  [[ -n "$_d" && -d "$_d" ]] || return 0
  for _f in "$_d"/*.conf; do
    [[ -f "$_f" ]] || continue
    _load_file "$_f"
  done
}

# Names only, one per line — for `--list`'s machine consumers and the
# "available:" tail of an error. Kept separate from `_recipe_list` so a
# future caller can ask for names without the prose.
_recipe_names_only() {
  local _r
  for _r in $_recipe_names; do
    [[ -n "$_r" ]] && printf '%s\n' "$_r"
  done | sort -u
  return 0
}

# Format the suggestion for an error message, or nothing at all. Kept apart
# from `_suggest_recipe` so the caller controls punctuation.
_recipe_hint() { # name
  local _s
  _s="$(_suggest_recipe "$1")"
  [[ -n "$_s" ]] && printf "\ndid you mean '%s'?" "$_s"
  return 0
}

# A close name from the book, for an unknown-recipe error. `just`'s "Did you
# mean 'build'?" is the single cheapest pickup aid in its toolkit: a typo is
# the most common failure at the front door, and the answer is already known.
# Plain edit-distance, capped so a wild guess never masquerades as help.
_suggest_recipe() { # name
  local _want="$1" _r _best="" _bestd=99 _d
  for _r in $(_recipe_names_only); do
    [[ "$_r" == "$_want" ]] && continue
    _d=$(_edit_distance "$_want" "$_r")
    if [[ "$_d" -lt "$_bestd" ]]; then _bestd="$_d"; _best="$_r"; fi
  done
  # Offer only a genuinely close match: within a third of the input's length,
  # or any prefix relationship ("go_" -> "go_test").
  [[ -n "$_best" ]] || return 0
  case "$_want" in
    "$_best"*) printf '%s' "$_best"; return 0 ;;
  esac
  case "$_best" in
    "$_want"*) printf '%s' "$_best"; return 0 ;;
  esac
  local _limit=$(( ${#_want} / 3 + 1 ))
  [[ "$_bestd" -le "$_limit" ]] && printf '%s' "$_best"
  return 0
}

# Levenshtein distance, iterative, no external tools. Bash 3.2 has no
# associative arrays, so the DP row is a plain indexed array. Names are short,
# so the O(n*m) cost is irrelevant.
_edit_distance() { # a b
  local _a="$1" _b="$2" _la=${#1} _lb=${#2} _i _j _cost
  [[ "$_a" == "$_b" ]] && { printf '0'; return 0; }
  [[ "$_la" -eq 0 ]] && { printf '%s' "$_lb"; return 0; }
  [[ "$_lb" -eq 0 ]] && { printf '%s' "$_la"; return 0; }
  local _prev _cur
  for (( _j=0; _j<=_lb; _j++ )); do _prev[$_j]=$_j; done
  for (( _i=1; _i<=_la; _i++ )); do
    _cur[0]=$_i
    for (( _j=1; _j<=_lb; _j++ )); do
      if [[ "${_a:_i-1:1}" == "${_b:_j-1:1}" ]]; then _cost=0; else _cost=1; fi
      local _del=$(( ${_prev[$_j]} + 1 )) _ins=$(( ${_cur[$((_j-1))]} + 1 ))
      local _sub=$(( ${_prev[$((_j-1))]} + _cost )) _min=$_del
      [[ "$_ins" -lt "$_min" ]] && _min=$_ins
      [[ "$_sub" -lt "$_min" ]] && _min=$_sub
      _cur[$_j]=$_min
    done
    for (( _j=0; _j<=_lb; _j++ )); do _prev[$_j]=${_cur[$_j]}; done
  done
  printf '%s' "${_prev[$_lb]}"
  return 0
}

# Shape a recipe's comment block into one list line. The shipped book opens
# each file with a prose paragraph whose first line is `<name> — <summary>`;
# the name is already the column, so drop the prefix, take the first sentence,
# and collapse whitespace. A `just` user expects exactly one line here, and a
# list that wraps is a list nobody reads.
_list_desc() { # name raw
  local _name="$1" _d="$2" _stripped
  [[ -n "$_d" ]] || return 0
  # Strip a leading `name — `, `name – `, `name - `, or `name: ` prefix. Match
  # the separator as a whole string (never `${x#?}`, which eats one byte of a
  # multibyte dash and leaves mojibake). The name is dropped whether or not a
  # space separates it from the punctuation, but only when one of these
  # separators follows, so a comment that is merely a sentence beginning with
  # the recipe name is left whole.
  case "$_d" in
    "$_name"[[:space:]]*)
      _stripped="$(_trim "${_d#"$_name"}")"
      case "$_stripped" in
        '— '*) _d="${_stripped#— }" ;;
        '– '*) _d="${_stripped#– }" ;;
        '- '*)  _d="${_stripped#- }" ;;
        ': '*)  _d="${_stripped#: }" ;;
      esac ;;
    "$_name"[—–-]*)
      _stripped="${_d#"$_name"}"
      case "$_stripped" in
        '— '*) _d="${_stripped#— }" ;;
        '– '*) _d="${_stripped#– }" ;;
        '- '*)  _d="${_stripped#- }" ;;
      esac ;;
    "$_name":*)
      _stripped="$(_trim "${_d#"$_name"}")"
      [[ "$_stripped" == ': '* ]] && _d="${_stripped#: }" ;;
  esac
  # First sentence: cut at the first `. ` with more text after it, keeping the
  # period. A description that is already one clause is left whole.
  case "$_d" in
    *'. '*) _d="${_d%%. *}." ;;
  esac
  if [[ ${#_d} -gt 72 ]]; then
    # Cut on a word boundary and append an ellipsis, so the column stays a
    # column and no line ends in a stray space.
    _d="$(_trim "${_d:0:69}")"
    _d="${_d% *}…"
  fi
  printf '%s' "$_d"
  return 0
}

# `--list`: the format's front door. A bare name teaches nothing; `just`
# showed that a name plus its one-line description is how a book becomes
# browsable without opening a file. The description is the comment block
# above the recipe (see `_load_file`), padded so the column of prose lines up.
# A machine recipe is marked, since it is never run on its own and a bare `bx
# <machine>` is a mistake worth preventing.
_recipe_list() {
  local _r _desc _cmd _kind _width=0
  for _r in $(_recipe_names_only); do
    [[ ${#_r} -gt $_width ]] && _width=${#_r}
  done
  for _r in $(_recipe_names_only); do
    eval "_desc=\${_desc_${_r}:-}"
    eval "_cmd=\${_cfg_${_r}_command:-}"
    [[ -n "$_cmd" ]] && _kind="" || _kind="  (machine)"
    _desc="$(_list_desc "$_r" "$_desc")"
    if [[ -n "$_desc" ]]; then
      printf '  %-*s  %s%s\n' "$_width" "$_r" "$_desc" "$_kind"
    else
      printf '  %-*s%s\n' "$_width" "$_r" "$_kind"
    fi
  done
  return 0
}

# Load every config source into scope. Call once, before resolving a recipe.
#
# Precedence (increasing), so a later source overrides an earlier one:
#   shipped machines/, shipped recipes/,
#   ~/.bx.conf, ./.bx.conf,
#   ~/.bx/machines/, ./.bx/machines/,
#   ~/.bx/recipes/,  ./.bx/recipes/
#
# Flat .bx.conf files may hold both kinds: a section with a `command` is a
# command recipe, one without is a machine recipe. Machine and command dirs are
# separate so the common case (many commands, few machines) reads clearly, but
# the grammar is identical and both may be loaded from either place.
_load_sources() {
  _recipe_names=""
  _file_desc=""
  local _book _mdir
  _book="$(_recipes_dir)"
  _mdir="$(_machines_dir)"
  _load_dir "$_mdir"
  _load_dir "$_book"
  _load_file "${HOME:-}/.bx.conf"
  _load_file "./.bx.conf"
  _load_dir "${HOME:-}/.bx/machines"
  _load_dir "./.bx/machines"
  _load_dir "${HOME:-}/.bx/recipes"
  _load_dir "./.bx/recipes"
}

# Record where each resolved key's winning value came from, for `--show`.
_prov=""
_provenance() { _prov="${_prov}${1}=${2}
"; }

# Split one `key = value` line and merge it into `_cfg_<recipe>_<key>`, applying
# the scalar/lists rules. `source` names where it came from for provenance.
_merge_recipe_line() {
  local _name="$1" _line="$2" _source="$3" _key _val _p _pv
  _key="$(_trim "${_line%%=*}")"
  _val="$(_trim "${_line#*=}")"
  _known_key "$_key" || _die "[${_name}] resolver produced unknown key '${_key}'"
  # Substitute resolver params into the value (`$AGENT_MODEL` and friends).
  for _p in $_params; do
    eval "_pv=\${_param_${_p}}"
    _val="${_val//\$${_p}/${_pv}}"
  done
  if _is_multi_key "$_key"; then
    _store_append "$_name" "$_key" "$_val"
  else
    _store_scalar "$_name" "$_key" "$_val"
  fi
  _provenance "${_name}.${_key}" "$_source"
}

# Run a recipe's resolver: a program referenced by name that emits recipe
# key=value lines, plus `@param N=V` and `@secret N=V` directives. It is the
# only way a recipe runs host code. See recipes/README.md.
_run_resolver() {
  local _name="$1" _resolve="$2" _book _exe _line _key _val
  [[ -n "$_resolve" ]] || return 0
  _book="$(_recipes_dir)"
  _exe=""
  case "$_resolve" in
    */*) [[ -x "$_resolve" ]] && _exe="$_resolve" ;;
    *)   if [[ -n "$_book" && -x "${_book}/${_resolve}" ]]; then _exe="${_book}/${_resolve}"
         elif command -v "$_resolve" >/dev/null 2>&1; then _exe="$(command -v "$_resolve")"; fi ;;
  esac
  [[ -n "$_exe" ]] || _die "[${_name}] resolve '${_resolve}' not found (looked in the book and PATH)"
  # Capture the resolver's exit status. It cannot come from a process
  # substitution (`done < <(...)` always reports 0), so the output is written to
  # a temp file and the resolver is run as a normal command whose status is
  # checked. A resolver that fails must stop the run: continuing would resolve
  # the recipe *without* the values it exists to supply — for `pi`, no name, no
  # secrets, no model — and run something the user did not ask for.
  local _out _resolver_status
  # A template is required: macOS `mktemp` rejects a bare invocation, so
  # `_out=$(mktemp)` fails there with a usage message and no file. Use the
  # portable form with an explicit template under $TMPDIR.
  _out="$(mktemp "${TMPDIR:-/tmp}/bx-resolver.XXXXXX")" || \
    _die "could not create a temp file for the resolver output"
  set +e
  BX_RECIPE="$_name" BX_RECIPE_DIR="$_book" "$_exe" >"$_out"
  _resolver_status=$?
  set -e
  if [[ "$_resolver_status" != 0 ]]; then
    rm -f "$_out"
    _die "[${_name}] resolver '${_resolve}' failed with status ${_resolver_status}.
A resolver supplies the values this recipe needs (name, secrets, model). Fix it
or remove 'resolve = ${_resolve}', then run again."
  fi
  while IFS= read -r _line || [[ -n "$_line" ]]; do
    [[ -n "$_line" ]] || continue
    case "$_line" in
      '#'*) continue ;;
      '@param '*) _key="${_line#@param }"; _val="${_key#*=}"; _key="${_key%%=*}"
                  eval "_param_${_key}=\$_val"; _params="${_params} ${_key}" ;;
      '@secret '*)
        _key="${_line#@secret }"; _val="${_key#*=}"; _key="${_key%%=*}"
        export "${_key}=${_val}" ;;
      '@'*) continue ;;
      *=*) _merge_recipe_line "$_name" "$_line" "resolver:${_resolve}" ;;
      *) rm -f "$_out"; _die "[${_name}] resolver ${_resolve}: unexpected output: ${_line}" ;;
    esac
  done <"$_out"
  rm -f "$_out"
  return 0
}

# Walk the extends chain, base last, copying inherited keys under the recipe's
# own. A cycle is an error. The leaf's resolver runs last, so its values win.
_resolve_extended() {
  local _name="$1" _cur _seen="" _base _k _baseval _curval _resv
  _cur="$_name"
  while [[ -n "$_cur" ]]; do
    case "
${_seen}" in *"
${_cur}
"*) _die "recipe '${_name}' extends in a cycle at '${_cur}'" ;; esac
    _seen="${_seen}${_cur}
"
    _base=""
    eval "_base=\${_cfg_${_cur}_extends:-}"
    if [[ -n "$_base" ]]; then
      _has_recipe "$_base" || _die "[${_cur}] extends unknown recipe '${_base}'"
      for _k in $_recipe_keys; do
        eval "_baseval=\${_cfg_${_base}_${_k}:-}"
        [[ -n "$_baseval" ]] || continue
        if _is_multi_key "$_k"; then
          eval "_curval=\${_cfg_${_cur}_${_k}:-}"
          if [[ -n "$_curval" ]]; then
            _store_scalar "$_cur" "$_k" "${_baseval}
${_curval}"
          else
            _store_scalar "$_cur" "$_k" "$_baseval"
          fi
        else
          eval "_curval=\${_cfg_${_cur}_${_k}:-}"
          [[ -n "$_curval" ]] || _store_scalar "$_cur" "$_k" "$_baseval"
        fi
      done
      _provenance "${_cur}.extends" "extends:${_base}"
    fi
    _cur="$_base"
  done
  eval "_resv=\${_cfg_${_name}_resolve:-}"
  [[ -n "$_resv" ]] && _run_resolver "$_name" "$_resv"
  return 0
}

# Merge `_cfg_<name>_*` into BX_* variables, after inheriting from any base
# recipe and running the resolver. A recipe is self-contained data plus, at
# most, one referenced resolver.
#
# A command recipe may name a machine (`machine = libc-dev`) and override any of
# that machine's shape keys. The machine is resolved first, then the command's
# own explicitly-set shape keys are overlaid. `--machine` on the command line
# (BX_MACHINE) replaces the whole shape: the named machine is used verbatim and
# the command recipe's machine reference and shape keys are ignored, while its
# command and lifecycle flags survive. `--name` likewise beats a recipe's
# `name`, because the command line is the more specific intent.
_resolve_recipe() {
  local _name="$1" _key _val
  _params=""
  _resolve_extended "$_name"

  local _ovr_machine="${BX_MACHINE:-}" _inline_machine=""
  eval "_inline_machine=\${_cfg_${_name}_machine:-}"
  [[ -n "$_ovr_machine" ]] && _inline_machine="$_ovr_machine"

  # A machine name that is also the recipe's own name is a mistake, not a
  # self-reference: it would borrow the command recipe's shape as if it were a
  # machine.
  if [[ -n "$_inline_machine" ]]; then
    if [[ "$_inline_machine" == "$_name" ]]; then
      _die "[${_name}] machine = ${_name} refers to itself; name the machine recipe something else"
    fi
    _has_recipe "$_inline_machine" || \
      _die "[${_name}] machine '${_inline_machine}' is not defined"
    _resolve_extended "$_inline_machine"
    for _key in $_shape_keys; do
      eval "_val=\${_cfg_${_inline_machine}_${_key}:-}"
      [[ -n "$_val" ]] || continue
      _provenance "${_name}.${_key}" "machine:${_inline_machine}"
      _apply_recipe_key "$_key" "$_val"
    done
  fi

  for _key in $_recipe_keys; do
    case "$_key" in extends|resolve|machine) continue ;; esac
    eval "_val=\${_cfg_${_name}_${_key}:-}"
    [[ -n "$_val" ]] || continue
    # With --machine, the command's shape keys are discarded: the named
    # machine owns the shape, and the command only contributes behavior.
    if [[ -n "$_ovr_machine" ]] && _is_shape_key "$_key"; then
      _provenance "${_name}.${_key}" "ignored:--machine"
      continue
    fi
    # --name on the command line wins over a recipe's `name`.
    if [[ "$_key" == name && -n "${_name_overridden:-}" ]]; then
      _provenance "${_name}.${_key}" "ignored:--name"
      continue
    fi
    _provenance "${_name}.${_key}" "recipe"
    _apply_recipe_key "$_key" "$_val"
  done
}

# Assign one resolved key into its BX_* variable. Kept separate so the machine
# overlay and the recipe merge share one mapping, and a new key cannot be added
# in one place and forgotten in the other.
_apply_recipe_key() { # key value
  local _key="$1" _val="$2"
  case "$_key" in
    command)       BX_COMMAND="$_val" ;;
    image)         BX_IMAGE="$_val" ;;
    name)          BX_NAME="$_val" ;;
    cpus)          BX_CPUS="$_val" ;;
    mem)           BX_MEM="$_val" ;;
    net)           BX_NET="$_val" ;;
    runtime_args)  BX_RUNTIME_ARGS="$_val" ;;
    mounts)        BX_MOUNTS="$_val" ;;
    workdir)       BX_WORKDIR="$_val" ;;
    keep)          BX_KEEP="$_val" ;;
    reset)         BX_RESET="$_val" ;;
    bootstrap)     BX_BOOTSTRAP="$_val" ;;
    bootstrap_env) BX_BOOTSTRAP_ENV="$_val" ;;
    secret_env)    BX_SECRET_ENV="$_val" ;;
    pre_command)   BX_PRE_COMMAND="$_val" ;;
    state_dir)     BX_STATE_DIR="$_val" ;;
    backend)       BX_BACKEND="$_val" ;;
    backend_prompt) BX_BACKEND_PROMPT="$_val" ;;
    profile)       BX_PROFILE="$_val" ;;
  esac
}

_dump_recipe() {
  local _name="$1" _spec
  # Validate secret lifetimes even when inspecting, so a typo is caught by
  # `--show` rather than only at run time. `_show` never runs the guest, so
  # this is safe to do here.
  while IFS= read -r _spec; do
    [[ -n "$_spec" ]] || continue
    _secret_split "$_spec"
  done < <(_read_lines "${BX_SECRET_ENV:-}")
  printf 'recipe=%s\n' "$_name"
  printf 'command=%s\n' "${BX_COMMAND:-}"
  printf 'image=%s\n' "${BX_IMAGE:-debian:bookworm-slim}"
  # `--show` does not pick a backend (it exits before the choice), so do not
  # imply one was chosen. Unset means the run will ask or use the only one
  # installed; naming smolvm here would be a claim `--show` cannot make.
  printf 'backend=%s\n' "${BX_BACKEND:-(unchosen; see --dry-run)}"
  printf 'backend_prompt=%s\n' "${BX_BACKEND_PROMPT:-0}"
  printf 'name=%s\n' "${BX_NAME:-bx}"
  printf 'cpus=%s\n' "${BX_CPUS:-4}"
  printf 'mem=%s\n' "${BX_MEM:-4096}"
  # Show `net` as the mode it means, not the raw flag, without running the
  # guard: `--show` must not fail on a config that a real run would refuse.
  case "${BX_NET:-1}" in
    0|none)   printf 'net=none\n' ;;
    1|bridge) printf 'net=bridge\n' ;;
    host)     printf 'net=host\n' ;;
    *)        printf 'net=%s (invalid)\n' "$BX_NET" ;;
  esac
  printf 'workdir=%s\n' "${BX_WORKDIR:-(none)}"
  printf 'keep=%s\n' "${BX_KEEP:-0}"
  printf 'reset=%s\n' "${BX_RESET:-0}"
  [[ -n "${BX_PROFILE:-}" ]] && printf 'profile=%s\n' "$BX_PROFILE"
  printf 'mounts=\n%s\n' "${BX_MOUNTS:-(none)}"
  [[ -n "${BX_RUNTIME_ARGS:-}" ]] && printf 'runtime_args=\n%s\n' "$BX_RUNTIME_ARGS"
  [[ -n "${BX_BOOTSTRAP_ENV:-}" ]] && printf 'bootstrap_env=\n%s\n' "$BX_BOOTSTRAP_ENV"
  [[ -n "${BX_SECRET_ENV:-}" ]] && printf 'secret_env=\n%s\n' "$BX_SECRET_ENV"
  [[ -n "${BX_PRE_COMMAND:-}" ]] && printf 'pre_command=%s\n' "$BX_PRE_COMMAND"
  # The bootstrap is often long; show that it is set and how big, not the
  # whole body, so `--show` stays readable. `--dry-run` prints it in full.
  if [[ -n "${BX_BOOTSTRAP:-}" ]]; then
    printf 'bootstrap=<%s lines>\n' "$(printf '%s' "$BX_BOOTSTRAP" | wc -l | tr -d ' ')"
  fi
  # Provenance, last and labelled, so a value can always be traced to its
  # source. Values themselves are not repeated here.
  if [[ -n "$_prov" ]]; then
    printf '\nsources=\n'
    printf '%s' "$_prov" | sort | sed 's/^/  /'
  fi
  return 0
}

# Write a starter recipe into ~/.bx/recipes, so a user's first recipe is one
# command. Never overwrites an existing file.
_scaffold_recipe() {
  local _name="$1" _dir="${HOME:-}/.bx/recipes" _file
  [[ "$_name" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || \
    _die "recipe name '$_name' is invalid; use letters, digits, or '_' (must not start with a digit)"
  mkdir -p "$_dir" || _die "could not create $_dir"
  _file="${_dir}/${_name}.conf"
  [[ -e "$_file" ]] && _die "$_file already exists"
  # The heredoc body is a recipe template, not shell; shellcheck reads the
  # `machine = ` lines as assignments.
  # shellcheck disable=SC2283
  cat >"$_file" <<EOF
# ${_name} — describe what this recipe does here. This first sentence is
# shown by \`bx --list\`, so make it count.
#
# Run it with: bx ${_name}
# Inspect it with: bx --show ${_name}
#
# This is a command recipe with a shape of its own. To share a shape with
# other recipes, put it in ~/.bx/machines/<name>.conf and replace the shape
# keys below with a single line:
#
#   machine = <name>
#
# A command recipe may still override any shape key after \`machine =\`.
#
# The format is documented with the book: recipes/README.md in a checkout,
# share/bx/recipes/README.md once installed.

[${_name}]
image    = debian:bookworm-slim
cpus     = 4
mem      = 4096
mounts   = \$PWD:/work
workdir  = /work
command  = echo hello from \$PWD
EOF
  _note "wrote $_file"
  _note "run it with: bx ${_name}"
  return 0
}

# ── arguments ───────────────────────────────────────────────────────────────
_recipe=""
_show=""
_new_recipe=""
_show_status=""
_gc=""
BX_PROFILE=""
_name_overridden=""
_passthrough=()
# Flags bx consumed for itself, kept so they can be replayed to a profile
# recipe, which owns its own machine and therefore wants --reset/--keep too.
_own_flags=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) BX_DRY_RUN=1; _own_flags+=(--dry-run); shift ;;
    --reset)   BX_RESET=1; _own_flags+=(--reset); shift ;;
    --keep)    BX_KEEP=1; _own_flags+=(--keep); shift ;;
    -q|--quiet)   _verbosity=0; _own_flags+=("$1"); shift ;;
    -v|--verbose) _verbosity=2; _own_flags+=("$1"); shift ;;
    --name)    [[ $# -ge 2 ]] || _die "--name needs a value"; BX_NAME="$2"; _name_overridden=1; shift 2 ;;
    --name=*)  BX_NAME="${1#*=}"; _name_overridden=1; shift ;;
    --machine) [[ $# -ge 2 ]] || _die "--machine needs a value"; BX_MACHINE="$2"; shift 2 ;;
    --machine=*) BX_MACHINE="${1#*=}"; shift ;;
    --list)    _load_sources; _recipe_list; exit 0 ;;
    --version) _show_version; exit 0 ;;
    --status)  _show_status=1; shift ;;
    --gc)      _gc=1; shift ;;
    --yes|-y)  _gc_yes=1; shift ;;
    --new)     [[ $# -ge 2 ]] || _die "--new needs a recipe name"; _new_recipe="$2"; shift 2 ;;
    --new=*)   _new_recipe="${1#*=}"; shift ;;
    --show)    [[ $# -ge 2 ]] || _die "--show needs a recipe name"; _show="$2"; shift 2 ;;
    --show=*)  _show="${1#*=}"; shift ;;
    -h|--help) _usage; exit 0 ;;
    --)        shift; _passthrough+=("$@"); break ;;
    -*)
      # Before a recipe is named, an unknown option is a mistake. After one, it
      # belongs to the recipe: `bx pi --reset -p hi` forwards both to the
      # recipe's command.
      if [[ -n "$_recipe" ]]; then _passthrough+=("$1"); shift
      else _die "unknown option: $1 (see --help)"; fi ;;
    *)
      if [[ -z "$_recipe" ]]; then _recipe="$1"; shift
      else _passthrough+=("$1"); shift; fi ;;
  esac
done

# Where to keep the lock and the recorded shape. Callers usually point this at
# a per-project, git-ignored directory; without a hint, use the XDG state dir
# so an installed bx works from any directory. Called from `--status`/`--gc`
# and from the run path, so the resolution lives in exactly one place.
_resolve_state_dir() {
  if [[ -n "${BX_STATE_DIR:-}" ]]; then
    printf '%s' "$BX_STATE_DIR"
  elif [[ -n "${XDG_STATE_HOME:-}" ]]; then
    printf '%s' "${XDG_STATE_HOME}/bx"
  elif [[ -n "${HOME:-}" && -d "${HOME}" ]]; then
    printf '%s' "${HOME}/.local/state/bx"
  else
    printf '%s' "${TMPDIR:-/tmp}/bx"
  fi
}

# Record the origin directory and secret lifetimes in the state file so
# `--status` can say where a machine came from and whether it may be reclaimed,
# and so a later run can warn about a persisted secret. A `1` marker means a
# non-ephemeral secret was declared for that machine.
_origin_dir() { printf '%s' "${BX_PI_DIR:-$PWD}"; }

# Machines are the `.state` files in the state dir. Their name is the file
# stem; the lock is `<name>.lock.d`.
_state_machines() {
  local _d _f _n
  _d="$(_resolve_state_dir)"
  [[ -d "$_d" ]] || return 0
  for _f in "$_d"/*.state; do
    [[ -f "$_f" ]] || continue
    _n="$(basename "$_f")"; _n="${_n%.state}"
    printf '%s\n' "$_n"
  done
  return 0
}

_state_field() { # statefile key
  [[ -f "$1" ]] || return 0
  sed -n "s/^$2=//p" "$1" | head -1
}

# A block field: everything after `key:` until the next top-level field, which
# is either `name:` (another block) or `name=` (a scalar). Used for
# secret_lifetimes, which is multi-line.
_state_block() { # statefile key
  [[ -f "$1" ]] || return 0
  sed -n "/^$2:/,/^[a-z_]*[=:]/p" "$1" | sed '1d' | sed '/^[a-z_]*[=:]/d'
}

# `--status` prints one machine per block: the recorded shape summary, the
# origin directory, whether that directory still exists (so the machine is
# reclaimable), whether the backend still knows it, and how big its private
# state is. This is the answer to "what exists, where, and from where" that
# the lifecycle otherwise leaves implicit. Each machine is read from its own
# recorded backend, so a vm and a container can be listed side by side.
_status_action() {
  local _name _file _origin _dir_ok _running _lifetimes _size _found=0 _b _rargs
  while IFS= read -r _name; do
    [[ -n "$_name" ]] || continue
    _found=1
    _file="$(_resolve_state_dir)/${_name}.state"
    _origin="$(_state_field "$_file" origin)"
    _dir_ok="gone"
    [[ -n "$_origin" && -d "$_origin" ]] && _dir_ok="present"
    # The backend is recorded in the state file, so a machine created as a vm
    # is queried as a vm even on a host where a container is the default. A
    # machine with no recorded backend predates the key; the engine says what
    # that omission means.
    _b="$(_state_field "$_file" backend)"
    [[ -n "$_b" ]] || _b="$(_bk_legacy_backend)"
    # Answer from the machine's own backend, by pointing the engine at it.
    _vm_name="$_name"
    _running="stopped"
    if _bk_available "$_b" && _bk_known "$_b"; then
      _backend="$_b"
      _bk exists && _running="exists"
    fi
    _lifetimes="$(_state_block "$_file" secret_lifetimes)"
    _lifetimes="${_lifetimes//$'\n'/, }"
    _size="?"
    if _bk_available "$_b" && _bk_known "$_b"; then
      _backend="$_b"
      _size="$(_bk size "$_name")"
    fi
    printf 'machine:  %s\n' "$_name"
    printf 'backend:  %s (%s)\n' "$_b" "$(_bk_label "$_b" 2>/dev/null || printf unknown)"
    printf 'image:    %s\n' "$(_state_field "$_file" image)"
    printf 'origin:   %s (%s)\n' "${_origin:-(unknown)}" "$_dir_ok"
    printf 'runtime:  %s\n' "$_running"
    printf 'size:     %s\n' "$_size"
    [[ -n "$_lifetimes" ]] && printf 'secrets:  %s\n' "$_lifetimes"
    # Raw runtime flags are shown whenever they were used, so a machine that
    # was created with a widened fence is never invisible in a listing.
    _rargs="$(_state_block "$_file" runtime_args)"
    _rargs="${_rargs//$'\n'/, }"
    [[ -n "$_rargs" ]] && printf 'runtime_args: %s\n' "$_rargs"
    printf 'state:    %s\n' "$_file"
    printf '\n'
  done < <(_state_machines)
  [[ "$_found" == 1 ]] || printf 'no machines in %s\n' "$(_resolve_state_dir)"
  return 0
}

# `--gc` deletes machines whose origin directory no longer exists. It prints
# the plan first and only acts with `--yes`, because deletion is the one thing
# here that is not reversible by reading state. A machine kept running on
# purpose (`--keep`) is reclaimed too: its origin is gone, so it is orphaned.
# Deletion goes through the machine's own backend, so a container is reclaimed
# with `podman rm` and a vm with `smolvm machine delete` without a branch here.
_gc_action() {
  local _name _file _origin _reclaim=0 _b
  while IFS= read -r _name; do
    [[ -n "$_name" ]] || continue
    _file="$(_resolve_state_dir)/${_name}.state"
    _origin="$(_state_field "$_file" origin)"
    if [[ -n "$_origin" && -d "$_origin" ]]; then
      continue
    fi
    _b="$(_state_field "$_file" backend)"
    [[ -n "$_b" ]] || _b="$(_bk_legacy_backend)"
    _reclaim=$((_reclaim + 1))
    printf 'reclaim: %s (%s; origin %s is gone)\n' \
      "$_name" "$(_bk_label "$_b" 2>/dev/null || printf '%s' "$_b")" "${_origin:-(unknown)}"
    if [[ "${_gc_yes:-0}" == "1" ]]; then
      if _bk_available "$_b"; then
        _vm_name="$_name"; _backend="$_b"
        _backend_delete
      else
        printf 'bx: %s is not on PATH; cannot delete %s\n' "$(_bk_program "$_b" 2>/dev/null || printf '%s' "$_b")" "$_name" >&2
      fi
      rm -f "$_file"
      rm -rf "$(_resolve_state_dir)/${_name}.lock.d"
      printf 'deleted: %s\n' "$_name"
    fi
  done < <(_state_machines)
  if [[ "$_reclaim" == 0 ]]; then
    printf 'nothing to reclaim\n'
  elif [[ "${_gc_yes:-0}" != "1" ]]; then
    printf '\npass --yes to delete the above\n'
  fi
  return 0
}

if [[ -n "$_new_recipe" ]]; then
  _scaffold_recipe "$_new_recipe"
  exit 0
fi

if [[ "${_show_status:-}" == "1" ]]; then
  _status_action
  exit 0
fi

if [[ "${_gc:-}" == "1" ]]; then
  _gc_action
  exit 0
fi


if [[ -n "$_show" || -n "$_recipe" ]]; then
  _load_sources
  _target="${_show:-$_recipe}"
  _has_recipe "$_target" || \
    _die "no recipe named '$_target' (available: $(printf '%s' "$(_recipe_names_only)" | tr '\n' ' '))$(_recipe_hint "$_target")"
  _resolve_recipe "$_target"
fi

if [[ -n "$_show" ]]; then
  _dump_recipe "$_show"
  exit 0
fi

# Extra arguments after the recipe are appended to its command, so
# `bx pi -p "hi"` forwards `-p "hi"` to pi.
if [[ ${#_passthrough[@]} -gt 0 ]]; then
  for _arg in "${_passthrough[@]}"; do
    printf -v _quoted '%q' "$_arg"
    BX_COMMAND="${BX_COMMAND:-} ${_quoted}"
  done
fi

# A recipe may name a host-side profile instead of describing a guest command.
# The profile owns its own machine, so bx hands off rather than starting one of
# its own: this is what makes a profile recipe mean "run that program" without
# nesting a VM inside a VM. Arguments pass through untouched, and `--dry-run`
# is the profile's to interpret (it has its own plan).
if [[ -n "$BX_PROFILE" ]]; then
  command -v "$BX_PROFILE" >/dev/null 2>&1 || \
    _die "profile '$BX_PROFILE' is not on PATH"
  # Replay the flags bx parsed for itself first, then the recipe's own args:
  # the profile owns the machine, so --reset/--keep/--dry-run are its to honor.
  exec "$BX_PROFILE" ${_own_flags[@]+"${_own_flags[@]}"} ${_passthrough[@]+"${_passthrough[@]}"}
fi

_image="${BX_IMAGE:-debian:bookworm-slim}"
_vm_name="${BX_NAME:-bx}"
_vm_cpus="${BX_CPUS:-4}"
_vm_mem="${BX_MEM:-4096}"
_net="${BX_NET:-1}"
_reset="${BX_RESET:-0}"
_keep="${BX_KEEP:-0}"
_workdir="${BX_WORKDIR:-}"
_command="${BX_COMMAND:-}"
_dry_run="${BX_DRY_RUN:-0}"
_no_lock="${BX_NO_LOCK:-0}"
_net_approved="${BX_NET_APPROVED:-0}"

if [[ -z "$_command" ]]; then
  if [[ -n "${_recipe:-}" ]] && _has_recipe "$_recipe"; then
    _die "'${_recipe}' is a machine recipe (no command); run a command recipe with 'machine = ${_recipe}', or pass a command after it"
  fi
  _die "no command: name a recipe (bx <recipe>) or set BX_COMMAND"
fi
[[ "$_vm_name" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]] || \
  _die "machine name '$_vm_name' is invalid; use letters, digits, '_' or '-'"

# A stable, comparable rendering of the mount set: order preserved, one per
# line, so it can be diffed and stored verbatim.
_want_mounts="$(_read_lines "${BX_MOUNTS:-}")"

# Backend-native create flags, one per line, order preserved — the same shape as
# `mounts`. They are read once here so the shape, `--dry-run`, and the create
# argv all agree byte-for-byte, and so a flag containing spaces survives as one
# argument rather than being re-split.
_want_runtime_args="$(_read_lines "${BX_RUNTIME_ARGS:-}")"

# Where to keep the lock and the recorded shape. Callers usually point this at
# a per-project, git-ignored directory; without a hint, use the XDG state dir
# so an installed bx works from any directory.
_state_dir="$(_resolve_state_dir)"
mkdir -p "$_state_dir" 2>/dev/null || _die "could not create state dir $_state_dir"
_state_file="${_state_dir}/${_vm_name}.state"
_lock_dir="${_state_dir}/${_vm_name}.lock.d"



# Past every inspection subcommand. A real run must have a runtime chosen, and
# the choice is made here so that `--status`, `--gc`, `--show`, and `--new`
# never prompt and never need a runtime installed.
_choose_backend

# ── networking, as an approved capability ──────────────────────────────────
# `net` is a mode, not a flag. It is normalized here, once, and it enters the
# shape in its normalized form, so a machine records `host` rather than `1` and
# a change of mode is a shape change like any other.
#
#   0 / none    no network at all
#   1 / bridge  the runtime's own NAT (the default)
#   host        share the runtime's network namespace
#
# The three modes are not interchangeable, and the one that works depends on
# where bx is running. A container on the runtime bridge cannot reach the
# network when bx itself is inside a vm whose networking is user-mode (krun's
# TSI hijack, visible as `tsi_hijack` in /proc/cmdline). TSI intercepts the
# guest's *own* sockets; it does not forward a container bridge's NAT, so DNS
# inside the container simply fails. Only `host` works there.
#
# So `net` has two states, and they are treated differently on purpose:
#
#   unset  the user did not ask for anything; bx picks the mode that works in
#          this environment (`host` under TSI, `bridge` otherwise) and says so.
#          Unset means "whatever works", so this is not a guess.
#   set    the user asked for a specific mode. If it is `bridge` under TSI,
#          that cannot work: bx refuses and names the fix rather than silently
#          overriding a stated choice. Naming `net = host` in the recipe is the
#          approval to share the guest's namespace; `BX_NET_APPROVED=1` is the
#          same approval for one run.
_net_explicit=0
[[ -n "${BX_NET:-}" ]] && _net_explicit=1

_normalize_net() {
  case "$_net" in
    0|none)   _net="none" ;;
    1|bridge) _net="bridge" ;;
    host)    _net="host" ;;
    *) _die "net='$_net' is not a mode; use none, bridge, or host" ;;
  esac
}

# Is this vm's networking user-mode (TSI), which cannot forward a container
# bridge? The marker is in the kernel command line smolvm boots with. The
# answer can be forced with BX_NESTED_NET=tsi|normal, so the behavior is
# testable (and debuggable) on a host whose /proc/cmdline cannot be changed.
_guest_is_tsi() {
  case "${BX_NESTED_NET:-}" in
    tsi)    return 0 ;;
    normal) return 1 ;;
  esac
  [[ -r /proc/cmdline ]] && grep -qw 'tsi_hijack' /proc/cmdline
}

# Decide the network mode, refusing only a choice that cannot work. `--dry-run`
# goes through here too: a plan that cannot run is not a plan, and finding out
# at create time instead of exec time is the difference this guard buys.
_net_guard() {
  # Only a backend whose `bridge` is a userspace NAT is affected; a vm has its
  # own net. Asking the backend keeps this guard free of runtime names.
  [[ "$(_bk net_is_bridged)" == "1" && "$_net" == "bridge" ]] || return 0
  _guest_is_tsi || return 0

  if [[ "$_net_approved" == "1" ]]; then
    # Approval to reach the network by sharing the guest's namespace.
    _net="host"
    return 0
  fi
  if [[ "$_net_explicit" == "0" ]]; then
    # Nothing was asked for. `bridge` cannot work here, so use `host` and say
    # so once: this is the documented preference for a nested bx, not a guess.
    _net="host"
    _run_note "container networking: using 'host' (this machine's network is user-mode; a bridge cannot route through it). Set net = bridge to be told instead, or net = none for no network."
    return 0
  fi
  _die "net = bridge cannot work here: bx is running inside a machine with
user-mode networking (krun/TSI), which cannot forward a container bridge, so
DNS and egress would fail at run time.

Two ways forward:
  net = host     share this machine's network (recommended in a nested bx)
  net = none     no network, if the command does not need it

Change it in the recipe, or run with BX_NET=host."
}

_normalize_net
_net_guard


# The recorded shape, or empty when this name has never been created here.
_recorded_shape() {
  [[ -f "$_state_file" ]] && cat "$_state_file"
}

_want_shape="image=$_image
cpus=$_vm_cpus
mem=$_vm_mem
net=$_net
backend=$_backend
mounts:
$_want_mounts"
# Normalize the trailing newline once, so the in-memory shape and the one read
# back from disk are byte-identical. Without this, an empty mount list leaves a
# stray blank line that makes a machine look like it changed shape every run.
_want_shape="${_want_shape%$'\n'}"
# `runtime_args` are bound at create time (they become part of the create argv),
# so they belong in the shape core: changing them cannot be applied to a running
# machine, and silently reusing one created with different flags is the same
# class of bug as reusing one with a different mount set. Recorded only when
# set, so a machine made before this key existed still matches and reuses.
if [[ -n "$_want_runtime_args" ]]; then
  _want_shape="${_want_shape}
runtime_args:
${_want_runtime_args}"
fi

# Parse the secret list once, into the args the backend needs plus the
# lifetimes bx records. The declared lifetime is a property of the shape, so a
# run that changes it (e.g. a value gaining `:persisted`) is a shape change and
# is reconciled like any other. This is what makes a secret's reach auditable
# instead of implicit.
#
# The value is passed by *name* either way: smolvm's `--secret-env GUEST=HOST`
# resolves HOST in the parent environment; podman has no equivalent, so bx
# exports HOST and asks podman for `-e GUEST`, omitting the value from argv.
# The invariant the test suite pins — the secret's value is never in argv —
# holds for both backends; only the *name* appears. Each backend renders its
# own arg and says whether the host variable must be exported; this loop never
# branches on the runtime.
_secret_args=()
_secret_exports=()
_secret_lifetimes_record=""
while IFS= read -r _spec; do
  [[ -n "$_spec" ]] || continue
  _secret_split "$_spec"
  # The backend appends its own arg(s) to `_secret_args`, and reports whether
  # the host variable must be exported so the value resolves at exec time.
  "bk_${_backend}_secret_arg"
  [[ "$(bk_"${_backend}"_secret_export)" == "1" ]] && _secret_exports+=("$_secret_host")
  _secret_lifetimes_record="${_secret_lifetimes_record}${_secret_guest}=${_secret_life}
"
done < <(_read_lines "${BX_SECRET_ENV:-}")
_secret_lifetimes_record="${_secret_lifetimes_record%$'\n'}"
_want_shape="${_want_shape}
secret_lifetimes:
${_secret_lifetimes_record}"
_want_shape="${_want_shape}
origin=$(_origin_dir)"

# A value declared `persisted` is allowed to reach a durable path. Say so when
# the machine is created — but not on every warm run: the warning is about the
# machine's shape, which is fixed at create time, so repeating it on each
# attach is the kind of chatter that makes `bx pi` feel unlike `pi`. `--status`
# always carries it, and `-v` shows it on any run.
if [[ "$_secret_lifetimes_record" == *"=persisted"* ]]; then
  _persisted_secret=1
else
  _persisted_secret=0
fi

# `runtime_args` are the backend's own flags, and bx passes them through
# without reading them. That is useful — it is how a capability the backend has
# but bx has no vocabulary for (running a container inside a container, say) is
# declared from a recipe — but it is also the one place a recipe can widen the
# fence, since a flag like podman's `--privileged` reaches well past the mount
# set bx controls. So it is explicit-only (never inferred, never defaulted) and
# warned about at create time, the same way a `persisted` secret is. The
# warning is about the machine's shape, so it fires on create, not on every
# warm attach; `--status` always carries it and `-v` shows it on any run.
if [[ -n "$_want_runtime_args" ]]; then
  _runtime_args_set=1
else
  _runtime_args_set=0
fi

# The shape's stable core is the create-time binding the backend fixes:
# image, resources, mounts, and which backend owns them. `secret_lifetimes`
# and `origin` are bx bookkeeping — they are recorded and reported, but they
# are not bound at create time, so a change in them must not force a recreate.
# `backend` joined the core when containers did: a vm and a container are not
# interchangeable, so a machine recorded without one is treated as `smolvm`
# (the only backend that existed) rather than as a mismatch.
#
# Keeping the comparison on the core means an old state file (written before
# these fields existed) still matches and reuses, rather than becoming a false
# conflict on upgrade.
_shape_matches() {
  [[ "$(_recorded_shape)" == "$_want_shape" ]] && return 0
  # Fall back to comparing only the create-time-bound core, so a record that
  # lacks the newer bookkeeping fields still reuses a matching machine.
  _rec="$(_recorded_shape)"
  [[ -n "$_rec" ]] || return 1
  local _rec_core _want_core
  _rec_core="$_rec"; _rec_core="${_rec_core%%$'\n'secret_lifetimes:*}"
  _rec_core="${_rec_core%%$'\n'origin=*}"
  _want_core="$_want_shape"; _want_core="${_want_core%%$'\n'secret_lifetimes:*}"
  _want_core="${_want_core%%$'\n'origin=*}"
  # A record with no `backend=` predates the key and was necessarily a smolvm
  # machine, so drop the line from the wanted core before comparing rather
  # than reporting a false conflict on the first run after an upgrade.
  if [[ "$_rec_core" != *$'\n'backend=* ]]; then
    _want_core="$(printf '%s\n' "$_want_core" | grep -v '^backend=')"
  fi
  [[ "$_rec_core" == "$_want_core" ]]
}

# ── plan, before doing anything ─────────────────────────────────────────────

# The image-cache and toolchain probes are backend knowledge and live in the
# verbs above; the plan just asks the chosen backend. Kept as thin wrappers so
# the cost model reads the same regardless of runtime.
_image_cached() { _backend_image_cached "$1"; }
_toolchain_present() { _backend_toolchain_present; }

_exists=0
_machine_exists && _exists=1

if [[ "$_reset" == "1" ]]; then
  _action="recreate"
elif [[ "$_exists" == "0" ]]; then
  _action="create"
elif _shape_matches; then
  _action="reuse"
else
  _action="conflict"
fi

if [[ "$_dry_run" == "1" ]]; then
  printf 'machine=%s
backend=%s\nimage=%s\ncpus=%s\nmem=%s\nnet=%s\nworkdir=%s\naction=%s\nlock=%s\nstate=%s\nmounts=' \
    "$_vm_name" "$_backend" "$_image" "$_vm_cpus" "$_vm_mem" "$_net" "${_workdir:-(none)}" \
    "$_action" "$_lock_dir" "$_state_file"
  if [[ -n "$_want_mounts" ]]; then
    printf '\n'
    printf '%s\n' "$_want_mounts"
  else
    printf '(none)\n'
  fi
  # The cost model. A first run is slow because of the toolchain install, not
  # because of the image; say which of the two applies, from state, so the
  # wait is predicted rather than discovered.
  [[ -n "$_secret_lifetimes_record" ]] && printf 'secret_lifetimes:\n%s\n' "$_secret_lifetimes_record"
  [[ -n "$_want_runtime_args" ]] && printf 'runtime_args:\n%s\n' "$_want_runtime_args"
  printf 'cache_image=%s\ncache_toolchain=%s\n' "$(_image_cached "$_image")" "$(_toolchain_present)"
  case "$_action" in
    create|recreate)
      printf 'estimate=first run in this directory: vm boot + toolchain install (network); later runs in this dir reuse the machine\n' ;;
    reuse)
      printf 'estimate=warm run: machine exists and matches the requested shape\n' ;;
    conflict)
      printf 'estimate=no run: the shape changed; pass --reset to recreate\n' ;;
  esac
  exit 0
fi

# A real run needs the runtime. `--dry-run` deliberately does not, so the plan
# and cost model can be inspected on a host without the backend installed.
[[ "$_backend_present" == "1" ]] || \
  _die "backend '$_backend' ($(_bk_label "$_backend") via '$(_bk_program "$_backend")') is not on PATH (it is required for a real run; --dry-run and --status do not need it)"
if [[ "$_action" == "conflict" ]]; then
  if [[ -z "$(_recorded_shape)" ]]; then
    _die "machine '$_vm_name' already exists but has no recorded shape (it was
created before bx tracked state, or by hand). Recreate it so its mounts and
resources are known: pass --reset."
  fi
  _die "machine '$_vm_name' was created with a different shape:
$(printf '%s\n' "$_want_shape" | sed 's/^/  want: /')
  have:
$(_recorded_shape | sed 's/^/    /')
the runtime binds mounts and resources at create time, so this cannot be fixed
by starting again. Pass --reset to recreate it."
fi

# ── lock ────────────────────────────────────────────────────────────────────
# One driver per machine. `mkdir` is atomic on every platform (macOS has no
# flock), so the lock is a directory holding the holder's pid. A second launch
# fails fast with that pid rather than sharing a VM and racing the stop trap.
if [[ "$_no_lock" != "1" ]]; then
  if ! mkdir "$_lock_dir" 2>/dev/null; then
    _holder="$(cat "$_lock_dir/pid" 2>/dev/null || echo unknown)"
    if [[ "$_holder" != "unknown" ]] && ! kill -0 "$_holder" 2>/dev/null; then
      # The holder is gone; a stale lock must not wedge every later launch.
      rm -rf "$_lock_dir"
      mkdir "$_lock_dir" 2>/dev/null || _die "could not take lock $_lock_dir"
    else
      _die "machine '$_vm_name' is already being driven by pid $_holder
(lock $_lock_dir). Wait for it to finish, or set BX_KEEP=1 and reuse the
running machine instead of starting a second one."
    fi
  fi
  printf '%s\n' "$$" >"$_lock_dir/pid"
fi

# ── lifecycle ───────────────────────────────────────────────────────────────
if [[ "$_action" == "recreate" && "$_exists" == "1" ]]; then
  _run_say "recreating $_vm_name"
  _backend_delete
  _exists=0
fi

if [[ "$_exists" == "0" ]]; then
  _backend_create_args
  # A first run is the only slow, chatty one: image pull, rootfs unpack. Say so
  # plainly, and surface the runtime's own output if it fails.
  _run_say "creating $_vm_name from $_image (first run; this may take a minute)"
  [[ "$_persisted_secret" == "1" ]] && \
    _run_note "this machine declares a persisted secret; its value may reach a durable path"
  # `runtime_args` are the backend's own flags, and bx does not read them. The
  # one worth naming is the widening one; say what was handed over, verbatim,
  # so it is never a surprise what the fence was opened with.
  if [[ "$_runtime_args_set" == "1" ]]; then
    _runtime_args_shown=""
    while IFS= read -r _arg; do
      [[ -n "$_arg" ]] || continue
      _runtime_args_shown="${_runtime_args_shown}${_runtime_args_shown:+ }${_arg}"
    done < <(printf '%s\n' "$_want_runtime_args")
    _run_note "this machine passes raw runtime flags: ${_runtime_args_shown}. bx does not interpret these; a flag like --privileged reaches past the mount fence."
  fi
  _backend_create
  printf '%s\n' "$_want_shape" >"$_state_file"
else
  # Warm path: the machine already exists with the right shape. Stay quiet
  # about reusing it — the user does not need to be told nothing happened.
  _trace "reusing machine $_vm_name"
fi

# Starting a stopped machine is an expected, silent step. Only replay the
# runtime's banner if it actually fails, or if the user asked for the trace.
_backend_start

# Stop the VM on exit unless the caller asked to keep it, and release the lock.
# The trap runs even after the guest command fails, so the machine is never
# left running by accident.
# shellcheck disable=SC2329  # invoked via trap
_cleanup() {
  local _status=$?
  [[ "$_no_lock" == "1" ]] || rm -rf "$_lock_dir"
  [[ "$_keep" == "1" ]] || _backend_stop
  return "$_status"
}
trap '_cleanup; exit $?' EXIT

# A caller may need to move files into the guest before the bootstrap runs
# (for example `smolvm machine cp`), which only makes sense once the machine
# is up. It is host-side shell, so it is evaluated here, not in the guest.
#
# `pre_command` is how a resolver hands a file to the guest, and a resolver
# commonly redirects to keep the console clean. That makes a failure invisible:
# under `set -e` a non-zero status here would abort bx with the command's exit
# code and print nothing at all, so the run would look like a silent `exit 1`.
# Run it with `set +e`, report what failed, and only then propagate the status.
if [[ -n "${BX_PRE_COMMAND:-}" ]]; then
  _trace "pre_command"
  set +e
  bash -c "$BX_PRE_COMMAND"
  _pre_status=$?
  set -e
  if [[ "$_pre_status" != 0 ]]; then
    _die "pre_command failed with status ${_pre_status}. The command was:
  ${BX_PRE_COMMAND}
It runs on the host after the machine starts and before the bootstrap. If its
output was redirected, run with BX_VERBOSE=2 to see the underlying command."
  fi
fi

_bootstrap_env_args=()
while IFS= read -r _pair; do
  [[ -n "$_pair" ]] || continue
  _backend_env_arg "$_pair"
done < <(_read_lines "${BX_BOOTSTRAP_ENV:-}")

# Forward the curated host environment (terminal type, locale, colour) so a
# program inside the machine behaves as it does on the host for the things a
# user controls. Only variables on the allowlist cross; a credential or socket
# variable is never included. `NAME=VALUE` sets the guest value literally, so
# each is expanded from the host here.
_passthrough_env_args=()
for _name in $_bx_env_passthrough; do
  _val="${!_name:-}"
  [[ -n "$_val" ]] || continue
  _backend_passthrough_arg "${_name}=${_val}"
done

# For podman, a secret crosses as `-e GUEST` and inherits its value from the
# exec's environment, so the host variable must be exported here. For smolvm,
# `--secret-env GUEST=HOST` does the resolution itself and nothing is exported.
# The backend reports which; this block does not know the runtime's name.
if [[ "$(_backend_secret_export)" == "1" && ${#_secret_exports[@]} -gt 0 ]]; then
  for _host_name in "${_secret_exports[@]}"; do
    # `export "$name"` exports the variable *named by* the value, which is
    # what we want here. shellcheck reads the quotes as an indirect-export
    # mistake; it is the documented idiom for a name held in a variable.
    # shellcheck disable=SC2163
    export "$_host_name"
  done
fi

if [[ -n "${BX_BOOTSTRAP:-}" ]]; then
  # The bootstrap is idempotent and runs on every boot, so it is only worth a
  # line when it actually installs something; on a warm machine it is a no-op
  # and printing "bootstrap" every launch is the noise this script exists to
  # avoid. `-v` always shows it.
  _trace "bootstrap"
  set +e
  _backend_exec_bootstrap
  _bootstrap_status=$?
  set -e
  # A bootstrap failure must say so. The runtime's own output has already gone
  # to the console (bx does not suppress it), but when a bootstrap is quiet on
  # the way to failing, the status alone is not a diagnosable error — name the
  # step so the exit code is never the whole story.
  if [[ "$_bootstrap_status" != 0 ]]; then
    _die "bootstrap failed with status ${_bootstrap_status}. The bootstrap runs in the guest before the command; see the output above, or run with BX_VERBOSE=2."
  fi
fi

if [[ -n "$_workdir" ]]; then
  _command="cd ${_workdir} && ${_command}"
fi

# Attach a TTY only when stdin and stdout are terminals; otherwise the caller
# may be piping and smolvm must not try to allocate a pty. This mirrors how a
# shell decides, so `bx pi` and `pi` agree on whether they are interactive.
#
# Run smolvm in the foreground, never `&`/background. A backgrounded process
# group is not the terminal's foreground group, so the `-i -t` exec is stopped
# by SIGTTIN the moment it reads stdin, never receives SIGWINCH, and leaves a
# TUI like pi with the wrong width — while an interactive `bx bash` accepts
# keystrokes that are merely echoed by the local terminal and never reach the
# guest. In the foreground the kernel delivers Ctrl-C and SIGWINCH to the whole
# job, so the guest gets a clean interrupt and a correctly sized pty, and `bx`
# and `pi` agree.
#
# Do not `exec` either: the EXIT trap must run to stop the machine and release
# the lock, and a replaced shell would skip it. Capture the guest status
# explicitly so it survives the cleanup trap rather than being flattened by
# `set -e`.
set +e
if [[ -t 0 && -t 1 ]]; then
  _backend_exec 1 "$_command"
else
  _backend_exec 0 "$_command"
fi
_guest_status=$?
set -e

exit "$_guest_status"
