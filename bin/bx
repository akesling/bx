#!/usr/bin/env bash
# bx — run a named recipe inside a smolvm microVM with host directories mounted.
#
# Usage:
#   bx <recipe> [args...]   # run a recipe (e.g. `bx pi`)
#   bx --list               # list available recipes
#   bx --show <recipe>      # print the resolved recipe without running it
#   bx --dry-run <recipe>   # print the machine plan without touching smolvm
#   bx --help
#
# Recipes are declarative: `[name]` followed by `key = value` lines, read from
# (in increasing precedence) the built-in defaults, ~/.bx.conf, ./.bx.conf, and
# per-recipe files under ~/.bx/recipes/ and ./.bx/recipes/. A recipe inherits
# the home and project defaults and may override any setting. Only `command`
# is required; the built-in `pi` recipe is always available.
#
# Recipe keys (every bx setting):
#   command, image, name, cpus, mem, net, mounts, workdir, keep, reset,
#   bootstrap, bootstrap_env, secret_env, pre_command, state_dir
# `mounts`, `bootstrap_env`, and `secret_env` may repeat; their lines are kept
# in order. `#` starts a comment; values run to end of line after trimming.
#
# The command runs through `bash -lc` (or `-i -t` when attached to a terminal)
# and its exit status becomes this script's exit status. Extra arguments after
# the recipe name are appended to the recipe's command.
#
# Environment overrides remain: any BX_* variable (BX_IMAGE, BX_CPUS, …) beats
# the config file, so an ad-hoc run needs no recipe.
#
# Concurrency: one machine may only be driven by one invocation at a time. A
# lock is taken per machine name; a second invocation fails fast rather than
# sharing a VM and racing its lifecycle.
#
# State: the machine's create-time shape (image, cpus, mem, mounts) is recorded
# beside the lock. A later run whose shape differs refuses and tells you to
# pass --reset, because smolvm binds mounts at create time and silently reusing
# a stale set is how boot panics happen.

set -euo pipefail

_die() { printf 'bx: %s\n' "$*" >&2; exit 1; }
_note() { printf 'bx: %s\n' "$*" >&2; }

_usage() {
  sed -n '2,34p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

# ── recipes ─────────────────────────────────────────────────────────────────
# A recipe is a `[name]` section of `key = value` lines. This is deliberately
# not TOML: the loader must work with nothing but bash, so the grammar is the
# smallest one bash can parse unambiguously. Values are taken verbatim (after
# trimming); repeating a multi-valued key appends rather than replaces.
#
# Bash 3.2 has no associative arrays, so a section's keys are held in variables
# named `_cfg_<recipe>_<key>`. Each `_load_file` overwrites a scalar (so the
# last file read wins) and appends to a multi-valued key (so all sources
# contribute, in the order read: home, project, per-recipe).

_recipe_keys="command image name cpus mem net mounts workdir keep reset bootstrap bootstrap_env secret_env pre_command state_dir profile"
_multi_keys="mounts bootstrap_env secret_env"

_known_key() {
  local _k
  for _k in $_recipe_keys; do [[ "$_k" == "$1" ]] && return 0; done
  return 1
}

_is_multi_key() {
  local _k
  for _k in $_multi_keys; do [[ "$_k" == "$1" ]] && return 0; done
  return 1
}

# Trim leading and trailing whitespace without external tools.
_trim() {
  local _s="$1"
  _s="${_s#"${_s%%[![:space:]]*}"}"
  _s="${_s%"${_s##*[![:space:]]}"}"
  printf '%s' "$_s"
}

_load_file() {
  local _file="$1" _line _section="" _key _val
  [[ -f "$_file" ]] || return 0
  while IFS= read -r _line || [[ -n "$_line" ]]; do
    _line="$(_trim "${_line%%#*}")"
    [[ -n "$_line" ]] || continue
    if [[ "$_line" == '['*']' ]]; then
      _section="$(_trim "${_line#[}")"
      _section="$(_trim "${_section%]}")"
      [[ -n "$_section" ]] || _die "$_file: empty recipe name"
      case "$_recipe_names" in
        *"
${_section}
"*) ;;
        *) _recipe_names="${_recipe_names}${_section}
" ;;
      esac
      continue
    fi
    [[ -n "$_section" ]] || _die "$_file: line outside a [recipe]: $_line"
    _key="$(_trim "${_line%%=*}")"
    _val="$(_trim "${_line#*=}")"
    [[ "$_line" == *=* ]] || _die "$_file: expected 'key = value': $_line"
    _known_key "$_key" || _die "$_file: unknown key '$_key' in [$_section]"
    # Expand the three references a recipe author actually reaches for, so a
    # mount can be written `$PWD:/work` or `~/src:/src`. Nothing else is
    # expanded: values are not shell-evaluated, so a recipe cannot run code.
    case "$_val" in
      *\$PWD*|*\$HOME*|*'~'*)
        _val="${_val//\$PWD/$PWD}"
        _val="${_val//\$HOME/${HOME:-}}"
        # A leading ~ is the home directory; there is no other tilde form here.
        case "$_val" in
          "~"/*) _val="${HOME:-}${_val:1}" ;;
          "~")   _val="${HOME:-}" ;;
        esac ;;
    esac
    if _is_multi_key "$_key"; then
      eval "_cfg_${_section}_${_key}=\"\${_cfg_${_section}_${_key}:+\${_cfg_${_section}_${_key}}
}${_val}\""
    else
      eval "_cfg_${_section}_${_key}=\$_val"
    fi
  done <"$_file"
}

# The names a recipe can refer to: every [section] seen, plus the built-in pi.
_recipe_names=""
_has_recipe() {
  local _name="$1"
  [[ "$_name" == "pi" ]] && return 0
  case "
${_recipe_names}" in
    *"
${_name}
"*) return 0 ;;
  esac
  return 1
}

_recipe_list() {
  local _r
  for _r in $_recipe_names pi; do
    [[ -n "$_r" ]] && printf '%s\n' "$_r"
  done | sort -u
  return 0
}

# Load every config source into scope. Call once, before resolving a recipe.
_load_sources() {
  _recipe_names=""
  _load_file "${HOME:-}/.bx.conf"
  _load_file "./.bx.conf"
  local _rf
  for _rf in "${HOME:-}/.bx/recipes" ./.bx/recipes; do
    [[ -d "$_rf" ]] || continue
    local _f
    for _f in "$_rf"/*.conf; do
      [[ -f "$_f" ]] || continue
      _load_file "$_f"
    done
  done
}

# Merge `_cfg_<name>_*` into BX_* variables. Scalar keys: a later source has
# already overwritten the variable, so it is the winner. Multi keys: the value
# accumulated in read order.
_resolve_recipe() {
  local _name="$1" _key _val
  # The built-in pi recipe is the profile that ships with bx. A `profile =` key
  # delegates the whole run to a host-side launcher (which owns its own
  # machine), so bx must not also create one. A user's own [pi] section, or a
  # pi.conf, is loaded first and wins over this default.
  if [[ "$_name" == "pi" ]]; then
    BX_PROFILE="${BX_PROFILE:-bx-pi}"
  fi
  for _key in $_recipe_keys; do
    eval "_val=\${_cfg_${_name}_${_key}:-}"
    [[ -n "$_val" ]] || continue
    case "$_key" in
      command)       BX_COMMAND="$_val" ;;
      image)         BX_IMAGE="$_val" ;;
      name)          BX_NAME="$_val" ;;
      cpus)          BX_CPUS="$_val" ;;
      mem)           BX_MEM="$_val" ;;
      net)           BX_NET="$_val" ;;
      mounts)        BX_MOUNTS="$_val" ;;
      workdir)       BX_WORKDIR="$_val" ;;
      keep)          BX_KEEP="$_val" ;;
      reset)         BX_RESET="$_val" ;;
      bootstrap)     BX_BOOTSTRAP="$_val" ;;
      bootstrap_env) BX_BOOTSTRAP_ENV="$_val" ;;
      secret_env)    BX_SECRET_ENV="$_val" ;;
      pre_command)   BX_PRE_COMMAND="$_val" ;;
      state_dir)     BX_STATE_DIR="$_val" ;;
      profile)       BX_PROFILE="$_val" ;;
    esac
  done
}

_dump_recipe() {
  local _name="$1"
  printf 'recipe=%s\n' "$_name"
  printf 'command=%s\n' "${BX_COMMAND:-}"
  printf 'image=%s\n' "${BX_IMAGE:-debian:bookworm-slim}"
  printf 'name=%s\n' "${BX_NAME:-bx}"
  printf 'cpus=%s\n' "${BX_CPUS:-4}"
  printf 'mem=%s\n' "${BX_MEM:-4096}"
  printf 'net=%s\n' "${BX_NET:-1}"
  printf 'workdir=%s\n' "${BX_WORKDIR:-(none)}"
  printf 'keep=%s\n' "${BX_KEEP:-0}"
  printf 'reset=%s\n' "${BX_RESET:-0}"
  [[ -n "${BX_PROFILE:-}" ]] && printf 'profile=%s\n' "$BX_PROFILE"
  printf 'mounts=\n%s\n' "${BX_MOUNTS:-(none)}"
  [[ -n "${BX_BOOTSTRAP_ENV:-}" ]] && printf 'bootstrap_env=\n%s\n' "$BX_BOOTSTRAP_ENV"
  [[ -n "${BX_SECRET_ENV:-}" ]] && printf 'secret_env=\n%s\n' "$BX_SECRET_ENV"
  [[ -n "${BX_PRE_COMMAND:-}" ]] && printf 'pre_command=%s\n' "$BX_PRE_COMMAND"
  return 0
}

# ── arguments ───────────────────────────────────────────────────────────────
# A bare word is a recipe name; flags are handled first so a recipe can never
# be shadowed by an option. Everything after the recipe is forwarded to it.
_recipe=""
_show=""
BX_PROFILE=""
_passthrough=()
# Flags bx consumed for itself, kept so they can be replayed to a profile
# recipe, which owns its own machine and therefore wants --reset/--keep too.
_own_flags=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) BX_DRY_RUN=1; _own_flags+=(--dry-run); shift ;;
    --reset)   BX_RESET=1; _own_flags+=(--reset); shift ;;
    --keep)    BX_KEEP=1; _own_flags+=(--keep); shift ;;
    --name)    [[ $# -ge 2 ]] || _die "--name needs a value"; BX_NAME="$2"; shift 2 ;;
    --name=*)  BX_NAME="${1#*=}"; shift ;;
    --list)    _load_sources; _recipe_list; exit 0 ;;
    --show)    [[ $# -ge 2 ]] || _die "--show needs a recipe name"; _show="$2"; shift 2 ;;
    --show=*)  _show="${1#*=}"; shift ;;
    -h|--help) _usage; exit 0 ;;
    --)        shift; _passthrough+=("$@"); break ;;
    -*)
      # Before a recipe is named, an unknown option is a mistake. After one, it
      # belongs to the recipe: `bx pi --reset -p hi` forwards both to bx-pi.
      if [[ -n "$_recipe" ]]; then _passthrough+=("$1"); shift
      else _die "unknown option: $1 (see --help)"; fi ;;
    *)
      if [[ -z "$_recipe" ]]; then _recipe="$1"; shift
      else _passthrough+=("$1"); shift; fi ;;
  esac
done

if [[ -n "$_show" || -n "$_recipe" ]]; then
  _load_sources
  _target="${_show:-$_recipe}"
  _has_recipe "$_target" || _die "no recipe named '$_target' (available: $(printf '%s' "$(_recipe_list)" | tr '\n' ' '))"
  _resolve_recipe "$_target"
fi

if [[ -n "$_show" ]]; then
  _dump_recipe "$_show"
  exit 0
fi

# Extra arguments after the recipe are appended to its command, so
# `bx pi -p "hi"` forwards `-p "hi"` to pi.
if [[ ${#_passthrough[@]} -gt 0 ]]; then
  for _arg in "${_passthrough[@]}"; do
    printf -v _quoted '%q' "$_arg"
    BX_COMMAND="${BX_COMMAND:-} ${_quoted}"
  done
fi

# A recipe may name a host-side profile instead of describing a guest command.
# The profile owns its own machine (bx-pi does), so bx hands off rather than
# starting one of its own: this is what makes `bx pi` mean "run the pi
# profile" without nesting a VM inside a VM. Arguments pass through untouched,
# and `--dry-run` is the profile's to interpret (bx-pi has its own plan).
if [[ -n "$BX_PROFILE" ]]; then
  command -v "$BX_PROFILE" >/dev/null 2>&1 || \
    _die "profile '$BX_PROFILE' is not on PATH"
  # Replay the flags bx parsed for itself first, then the recipe's own args:
  # the profile owns the machine, so --reset/--keep/--dry-run are its to honor.
  exec "$BX_PROFILE" ${_own_flags[@]+"${_own_flags[@]}"} ${_passthrough[@]+"${_passthrough[@]}"}
fi

command -v smolvm >/dev/null 2>&1 || _die "smolvm is not on PATH"

_image="${BX_IMAGE:-debian:bookworm-slim}"
_vm_name="${BX_NAME:-bx}"
_vm_cpus="${BX_CPUS:-4}"
_vm_mem="${BX_MEM:-4096}"
_net="${BX_NET:-1}"
_reset="${BX_RESET:-0}"
_keep="${BX_KEEP:-0}"
_workdir="${BX_WORKDIR:-}"
_command="${BX_COMMAND:-}"
_dry_run="${BX_DRY_RUN:-0}"
_no_lock="${BX_NO_LOCK:-0}"

[[ -n "$_command" ]] || _die "no command: name a recipe (bx <recipe>) or set BX_COMMAND"
[[ "$_vm_name" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]] || \
  _die "machine name '$_vm_name' is invalid; use letters, digits, '_' or '-'"

# Mounts, bootstrap env, and secret env are newline-separated so a caller can
# build them with ordinary string concatenation and still name paths with
# spaces. Empty entries are ignored. Always returns 0: under `set -e` a
# function whose loop body never runs would otherwise abort the caller.
_read_lines() {
  local _line
  while IFS= read -r _line; do
    [[ -n "$_line" ]] && printf '%s\n' "$_line"
  done <<<"${1:-}"
  return 0
}

# A stable, comparable rendering of the mount set: order preserved, one per
# line, so it can be diffed and stored verbatim.
_want_mounts="$(_read_lines "${BX_MOUNTS:-}")"

# Where to keep the lock and the recorded shape. Callers usually point this at
# a per-project, git-ignored directory; without a hint, use the XDG state dir
# so an installed bx works from any directory.
if [[ -n "${BX_STATE_DIR:-}" ]]; then
  _state_dir="$BX_STATE_DIR"
elif [[ -n "${XDG_STATE_HOME:-}" ]]; then
  _state_dir="${XDG_STATE_HOME}/bx"
elif [[ -n "${HOME:-}" && -d "${HOME}" ]]; then
  _state_dir="${HOME}/.local/state/bx"
else
  _state_dir="${TMPDIR:-/tmp}/bx"
fi
mkdir -p "$_state_dir" 2>/dev/null || _die "could not create state dir $_state_dir"
_state_file="${_state_dir}/${_vm_name}.state"
_lock_dir="${_state_dir}/${_vm_name}.lock.d"

_machine_exists() {
  smolvm machine ls -q 2>/dev/null | grep -qx "$_vm_name"
}

# The recorded shape, or empty when this name has never been created here.
_recorded_shape() {
  [[ -f "$_state_file" ]] && cat "$_state_file"
}

_want_shape="image=$_image
cpus=$_vm_cpus
mem=$_vm_mem
net=$_net
mounts:
$_want_mounts"

_shape_matches() {
  [[ "$(_recorded_shape)" == "$_want_shape" ]]
}

# ── plan, before doing anything ─────────────────────────────────────────────
_exists=0
_machine_exists && _exists=1

if [[ "$_reset" == "1" ]]; then
  _action="recreate"
elif [[ "$_exists" == "0" ]]; then
  _action="create"
elif _shape_matches; then
  _action="reuse"
else
  _action="conflict"
fi

if [[ "$_dry_run" == "1" ]]; then
  printf 'machine=%s\nimage=%s\ncpus=%s\nmem=%s\nnet=%s\nworkdir=%s\naction=%s\nlock=%s\nstate=%s\nmounts=' \
    "$_vm_name" "$_image" "$_vm_cpus" "$_vm_mem" "$_net" "${_workdir:-(none)}" \
    "$_action" "$_lock_dir" "$_state_file"
  if [[ -n "$_want_mounts" ]]; then
    printf '\n'
    printf '%s\n' "$_want_mounts"
  else
    printf '(none)\n'
  fi
  exit 0
fi

if [[ "$_action" == "conflict" ]]; then
  if [[ -z "$(_recorded_shape)" ]]; then
    _die "machine '$_vm_name' already exists but has no recorded shape (it was
created before bx tracked state, or by hand). Recreate it so its mounts and
resources are known: pass --reset."
  fi
  _die "machine '$_vm_name' was created with a different shape:
$(printf '%s\n' "$_want_shape" | sed 's/^/  want: /')
  have:
$(_recorded_shape | sed 's/^/    /')
smolvm binds mounts and resources at create time, so this cannot be fixed by
starting again. Pass --reset to recreate it."
fi

# ── lock ────────────────────────────────────────────────────────────────────
# One driver per machine. `mkdir` is atomic on every platform (macOS has no
# flock), so the lock is a directory holding the holder's pid. A second launch
# fails fast with that pid rather than sharing a VM and racing the stop trap.
if [[ "$_no_lock" != "1" ]]; then
  if ! mkdir "$_lock_dir" 2>/dev/null; then
    _holder="$(cat "$_lock_dir/pid" 2>/dev/null || echo unknown)"
    if [[ "$_holder" != "unknown" ]] && ! kill -0 "$_holder" 2>/dev/null; then
      # The holder is gone; a stale lock must not wedge every later launch.
      rm -rf "$_lock_dir"
      mkdir "$_lock_dir" 2>/dev/null || _die "could not take lock $_lock_dir"
    else
      _die "machine '$_vm_name' is already being driven by pid $_holder
(lock $_lock_dir). Wait for it to finish, or set BX_KEEP=1 and reuse the
running machine instead of starting a second one."
    fi
  fi
  printf '%s\n' "$$" >"$_lock_dir/pid"
fi

# ── lifecycle ───────────────────────────────────────────────────────────────
if [[ "$_action" == "recreate" && "$_exists" == "1" ]]; then
  _note "recreating machine $_vm_name"
  smolvm machine delete --name "$_vm_name" -f >/dev/null 2>&1 || true
  _exists=0
fi

if [[ "$_exists" == "0" ]]; then
  _create_args=(--name "$_vm_name" --image "$_image" --cpus "$_vm_cpus" --mem "$_vm_mem")
  [[ "$_net" == "1" ]] && _create_args+=(--net)
  while IFS= read -r _mount; do
    [[ -n "$_mount" ]] || continue
    _create_args+=(--volume "$_mount")
  done < <(printf '%s\n' "$_want_mounts")
  _note "creating machine $_vm_name from $_image"
  smolvm machine create "${_create_args[@]}" || _die "could not create machine $_vm_name"
  printf '%s\n' "$_want_shape" >"$_state_file"
else
  _note "reusing machine $_vm_name"
fi

if ! smolvm machine start --name "$_vm_name" >/dev/null; then
  _die "machine '$_vm_name' failed to start. If its mounts or image changed
since it was created, recreate it: bx --reset"
fi

# Stop the VM on exit unless the caller asked to keep it, and release the lock.
# The trap runs even after the guest command fails, so the machine is never
# left running by accident.
# shellcheck disable=SC2329  # invoked via trap
_cleanup() {
  local _status=$?
  [[ "$_no_lock" == "1" ]] || rm -rf "$_lock_dir"
  [[ "$_keep" == "1" ]] || smolvm machine stop --name "$_vm_name" >/dev/null 2>&1 || true
  return "$_status"
}
trap '_cleanup; exit $?' EXIT

# A caller may need to move files into the guest before the bootstrap runs
# (for example `smolvm machine cp`), which only makes sense once the machine
# is up. It is host-side shell, so it is evaluated here, not in the guest.
if [[ -n "${BX_PRE_COMMAND:-}" ]]; then
  bash -c "$BX_PRE_COMMAND"
fi

# `--secret-env GUEST=HOST` makes smolvm read HOST from this environment and
# inject it as GUEST, so values never appear in argv or in this script's output.
_secret_args=()
while IFS= read -r _pair; do
  [[ -n "$_pair" ]] || continue
  _secret_args+=(--secret-env "$_pair")
done < <(_read_lines "${BX_SECRET_ENV:-}")

_bootstrap_env_args=()
while IFS= read -r _pair; do
  [[ -n "$_pair" ]] || continue
  _bootstrap_env_args+=(--env "$_pair")
done < <(_read_lines "${BX_BOOTSTRAP_ENV:-}")

if [[ -n "${BX_BOOTSTRAP:-}" ]]; then
  _note "bootstrap"
  smolvm machine exec --name "$_vm_name" \
    ${_secret_args[@]+"${_secret_args[@]}"} \
    ${_bootstrap_env_args[@]+"${_bootstrap_env_args[@]}"} \
    -- bash -c "$BX_BOOTSTRAP"
fi

if [[ -n "$_workdir" ]]; then
  _command="cd ${_workdir} && ${_command}"
fi

# Attach a TTY only when there is one; otherwise the caller may be piping.
# Do not `exec`: the EXIT trap must run to stop the machine and release the
# lock, and a replaced shell would skip it. Capture the guest status explicitly
# so it survives the cleanup trap rather than being flattened by `set -e`.
set +e
if [[ -t 0 && -t 1 ]]; then
  smolvm machine exec --name "$_vm_name" -i -t \
    ${_secret_args[@]+"${_secret_args[@]}"} \
    -- bash -lc "$_command"
else
  smolvm machine exec --name "$_vm_name" \
    ${_secret_args[@]+"${_secret_args[@]}"} \
    -- bash -lc "$_command"
fi
_guest_status=$?
set -e

exit "$_guest_status"
